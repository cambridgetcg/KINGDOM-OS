{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thekingdom.dev/schemas/world-commons/0.1.json",
  "title": "The Kingdom World Commons 0.1",
  "description": "A reviewed catalog of public-interest resources with access, reuse, automation, provenance, and care boundaries kept distinct.",
  "$comment": "The source validator also enforces unique ids, valid references, category and foundation coverage, unique link type/url pairs, aligned verification dates, real calendar dates, and credential-free HTTPS URLs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated",
    "verified",
    "canonical_url",
    "promise",
    "methodology",
    "privacy",
    "foundation",
    "categories",
    "kits",
    "resources"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "thekingdom.world-commons/0.1"
    },
    "generated": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|[+-](?:(?:0\\d|1[0-3]):[0-5]\\d|14:00))$"
        }
      ]
    },
    "verified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "canonical_url": {
      "type": "string",
      "const": "https://thekingdom.dev/commons.json"
    },
    "promise": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1000,
      "pattern": "^\\s*\\S[\\s\\S]{18,}\\S\\s*$"
    },
    "methodology": {
      "$ref": "#/$defs/methodology"
    },
    "privacy": {
      "$ref": "#/$defs/privacy"
    },
    "foundation": {
      "$ref": "#/$defs/foundation"
    },
    "categories": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/category"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "const": "knowledge"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/category"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "const": "learning"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/category"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "const": "earth"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/category"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "const": "public-life"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/category"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "const": "rights"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/category"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "const": "resilience"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/category"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "const": "security"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/category"
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "const": "culture"
                }
              }
            }
          ]
        }
      ],
      "items": false
    },
    "kits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/kit"
      }
    },
    "resources": {
      "type": "array",
      "minItems": 8,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/resource"
      }
    }
  },
  "$defs": {
    "methodology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "classification",
        "maintenance",
        "boundary"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1000,
          "pattern": "^\\s*\\S[\\s\\S]{18,}\\S\\s*$"
        },
        "classification": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1000,
          "pattern": "^\\s*\\S[\\s\\S]{18,}\\S\\s*$"
        },
        "maintenance": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1000,
          "pattern": "^\\s*\\S[\\s\\S]{18,}\\S\\s*$"
        },
        "boundary": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1000,
          "pattern": "^\\s*\\S[\\s\\S]{18,}\\S\\s*$"
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_surface",
        "machine_surface"
      ],
      "properties": {
        "human_surface": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1000,
          "pattern": "^\\s*\\S[\\s\\S]{18,}\\S\\s*$"
        },
        "machine_surface": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1000,
          "pattern": "^\\s*\\S[\\s\\S]{18,}\\S\\s*$"
        }
      }
    },
    "foundation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meaning",
        "criteria",
        "resource_ids"
      ],
      "properties": {
        "meaning": {
          "type": "string",
          "minLength": 30,
          "maxLength": 1000,
          "pattern": "^\\s*\\S[\\s\\S]{28,}\\S\\s*$"
        },
        "criteria": {
          "type": "array",
          "minItems": 3,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "^\\s*\\S(?:[\\s\\S]*\\S)?\\s*$"
          }
        },
        "resource_ids": {
          "type": "array",
          "minItems": 4,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 64
          }
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "glyph",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "knowledge",
            "learning",
            "earth",
            "public-life",
            "rights",
            "resilience",
            "security",
            "culture"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "pattern": "^\\s*\\S[\\s\\S]{0,}\\S\\s*$"
        },
        "glyph": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^\\s*\\S(?:[\\s\\S]*\\S)?\\s*$"
        },
        "description": {
          "type": "string",
          "minLength": 12,
          "maxLength": 500,
          "pattern": "^\\s*\\S[\\s\\S]{10,}\\S\\s*$"
        }
      }
    },
    "kit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "glyph",
        "invitation",
        "keywords",
        "resource_ids",
        "boundary",
        "steps"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160,
          "pattern": "^\\s*\\S[\\s\\S]{0,}\\S\\s*$"
        },
        "glyph": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^\\s*\\S(?:[\\s\\S]*\\S)?\\s*$"
        },
        "invitation": {
          "type": "string",
          "minLength": 20,
          "maxLength": 800,
          "pattern": "^\\s*\\S[\\s\\S]{18,}\\S\\s*$"
        },
        "keywords": {
          "type": "array",
          "minItems": 2,
          "maxItems": 24,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "^\\s*\\S(?:[\\s\\S]*\\S)?\\s*$"
          }
        },
        "resource_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 64
          }
        },
        "boundary": {
          "type": "string",
          "minLength": 20,
          "maxLength": 800,
          "pattern": "^\\s*\\S[\\s\\S]{18,}\\S\\s*$"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "^\\s*\\S(?:[\\s\\S]*\\S)?\\s*$"
          }
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cost",
        "account",
        "note"
      ],
      "properties": {
        "cost": {
          "type": "string",
          "enum": [
            "free",
            "free-tier",
            "local-costs"
          ]
        },
        "account": {
          "type": "string",
          "enum": [
            "none",
            "free-account",
            "varies",
            "contact"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 12,
          "maxLength": 700,
          "pattern": "^\\s*\\S[\\s\\S]{10,}\\S\\s*$"
        }
      }
    },
    "reuse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "license",
        "note"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "open",
            "mixed",
            "public-access",
            "noncommercial"
          ]
        },
        "license": {
          "type": "string",
          "minLength": 2,
          "maxLength": 300,
          "pattern": "^\\s*\\S[\\s\\S]{0,}\\S\\s*$"
        },
        "note": {
          "type": "string",
          "minLength": 12,
          "maxLength": 700,
          "pattern": "^\\s*\\S[\\s\\S]{10,}\\S\\s*$"
        }
      }
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "auth",
        "limits",
        "note"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "supported",
            "limited",
            "human-only",
            "bulk-preferred",
            "local"
          ]
        },
        "auth": {
          "type": "string",
          "enum": [
            "none",
            "free-key",
            "varies",
            "contact",
            "not-applicable"
          ]
        },
        "limits": {
          "type": "string",
          "minLength": 8,
          "maxLength": 700,
          "pattern": "^\\s*\\S[\\s\\S]{6,}\\S\\s*$"
        },
        "note": {
          "type": "string",
          "minLength": 12,
          "maxLength": 700,
          "pattern": "^\\s*\\S[\\s\\S]{10,}\\S\\s*$"
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "url",
        "type"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "pattern": "^\\s*\\S[\\s\\S]{0,}\\S\\s*$"
        },
        "url": {
          "type": "string",
          "pattern": "^https://",
          "minLength": 10,
          "maxLength": 2000
        },
        "type": {
          "type": "string",
          "enum": [
            "start",
            "api",
            "bulk",
            "terms",
            "docs"
          ]
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "provider",
        "category_ids",
        "description",
        "good_for",
        "coverage",
        "keywords",
        "audiences",
        "access",
        "reuse",
        "automation",
        "links",
        "caveat",
        "verified"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160,
          "pattern": "^\\s*\\S[\\s\\S]{0,}\\S\\s*$"
        },
        "provider": {
          "type": "string",
          "minLength": 2,
          "maxLength": 240,
          "pattern": "^\\s*\\S[\\s\\S]{0,}\\S\\s*$"
        },
        "category_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "knowledge",
              "learning",
              "earth",
              "public-life",
              "rights",
              "resilience",
              "security",
              "culture"
            ]
          }
        },
        "description": {
          "type": "string",
          "minLength": 20,
          "maxLength": 800,
          "pattern": "^\\s*\\S[\\s\\S]{18,}\\S\\s*$"
        },
        "good_for": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "^\\s*\\S(?:[\\s\\S]*\\S)?\\s*$"
          }
        },
        "coverage": {
          "type": "string",
          "minLength": 12,
          "maxLength": 700,
          "pattern": "^\\s*\\S[\\s\\S]{10,}\\S\\s*$"
        },
        "keywords": {
          "type": "array",
          "minItems": 2,
          "maxItems": 24,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "^\\s*\\S(?:[\\s\\S]*\\S)?\\s*$"
          }
        },
        "audiences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "^\\s*\\S(?:[\\s\\S]*\\S)?\\s*$"
          }
        },
        "access": {
          "$ref": "#/$defs/access"
        },
        "reuse": {
          "$ref": "#/$defs/reuse"
        },
        "automation": {
          "$ref": "#/$defs/automation"
        },
        "links": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "caveat": {
          "type": "string",
          "minLength": 20,
          "maxLength": 800,
          "pattern": "^\\s*\\S[\\s\\S]{18,}\\S\\s*$"
        },
        "verified": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    }
  }
}