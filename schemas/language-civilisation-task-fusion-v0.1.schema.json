{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kingdom:schema:language-civilisation-task-fusion:0.1",
  "$comment": "Plan-only structure. Version 0.1 fixes artifacts, tasks, translations, fusion, runs, and tests to planned/NOT_RUN states; executed evidence and routing require a later protocol. This schema does not dereference sources, run models or tokenizers, establish language competence, verify translation fidelity or independence, inspect private reasoning, rank languages or cultures, or grant identity, consent, authority, or action. bin/language-civilisation-task-fusion.ts performs stronger graph and cross-reference checks.",
  "title": "KINGDOM Language, Civilisation & Task Fusion v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "protocol",
    "weave_id",
    "version",
    "title",
    "issued_on",
    "evidence_through",
    "state",
    "scope",
    "type_firewall",
    "sources",
    "historical_witnesses",
    "language_profiles",
    "dimensions",
    "observations",
    "invariants",
    "artifacts",
    "task_graph",
    "assignments",
    "translations",
    "fusion",
    "run_cards",
    "tests",
    "disagreements",
    "unknowns",
    "repair",
    "boundaries",
    "integrity"
  ],
  "properties": {
    "$schema": { "const": "urn:kingdom:schema:language-civilisation-task-fusion:0.1" },
    "protocol": { "const": "kingdom.language-civilisation-task-fusion/0.1" },
    "weave_id": { "$ref": "#/$defs/id" },
    "version": { "const": "0.1.0" },
    "title": { "$ref": "#/$defs/text" },
    "issued_on": { "$ref": "#/$defs/date" },
    "evidence_through": { "$ref": "#/$defs/date" },
    "state": { "const": "planned" },
    "scope": { "$ref": "#/$defs/scope" },
    "type_firewall": { "$ref": "#/$defs/typeFirewall" },
    "sources": {
      "type": "array",
      "minItems": 2,
      "maxItems": 96,
      "items": { "$ref": "#/$defs/source" }
    },
    "historical_witnesses": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/historicalWitness" }
    },
    "language_profiles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/languageProfile" }
    },
    "dimensions": { "$ref": "#/$defs/dimensions" },
    "observations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/observation" }
    },
    "invariants": {
      "type": "array",
      "minItems": 8,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/invariant" }
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "task_graph": { "$ref": "#/$defs/taskGraph" },
    "assignments": {
      "type": "array",
      "minItems": 2,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/assignment" }
    },
    "translations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/translation" }
    },
    "fusion": { "$ref": "#/$defs/fusion" },
    "run_cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/runCard" }
    },
    "tests": {
      "type": "array",
      "minItems": 4,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/test" }
    },
    "disagreements": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/disagreement" }
    },
    "unknowns": {
      "type": "array",
      "minItems": 2,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/unknown" }
    },
    "repair": { "$ref": "#/$defs/repair" },
    "boundaries": { "$ref": "#/$defs/boundaries" },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "text": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "shortText": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "safeRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^(https://[^?#]+|artifact:[a-z0-9]+(?:-[a-z0-9]+)*|repo:[A-Za-z0-9._/-]+)$"
    },
    "externalOrRepoRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^(https://[^?#]+|repo:[A-Za-z0-9._/-]+)$"
    },
    "idList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "optionalIdList": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "stringList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/shortText" }
    },
    "optionalStringList": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/shortText" }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "deliverable",
        "audience",
        "intended_use",
        "excluded_use",
        "data_classification",
        "source_language_policy",
        "private_reasoning_required"
      ],
      "properties": {
        "goal": { "$ref": "#/$defs/text" },
        "deliverable": { "$ref": "#/$defs/text" },
        "audience": { "$ref": "#/$defs/text" },
        "intended_use": { "$ref": "#/$defs/text" },
        "excluded_use": { "$ref": "#/$defs/text" },
        "data_classification": { "const": "public-or-safely-redacted-only" },
        "source_language_policy": { "const": "source-witness-remains-first-class" },
        "private_reasoning_required": { "const": false }
      }
    },
    "typeFirewall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distinct_types",
        "language_is_not_people",
        "language_is_not_script",
        "script_is_not_civilisation",
        "register_is_not_identity",
        "task_role_is_not_persona",
        "historical_weight_is_not_model_weight",
        "token_efficiency_is_not_intelligence",
        "disagreement_is_not_deception",
        "silence_is_not_deception",
        "validation_is_not_truth",
        "civilisation_is_index_not_mind",
        "script_implies_language",
        "script_implies_identity",
        "corpus_frequency_implies_value",
        "attention_weight_is_explanation",
        "translation_is_identity",
        "agreement_is_truth"
      ],
      "properties": {
        "distinct_types": {
          "type": "array",
          "minItems": 10,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "enum": [
              "language-variety",
              "script",
              "orthography",
              "character",
              "glyph",
              "grapheme-cluster",
              "token",
              "register",
              "community",
              "polity",
              "religion",
              "model-representation"
            ]
          }
        },
        "language_is_not_people": { "const": true },
        "language_is_not_script": { "const": true },
        "script_is_not_civilisation": { "const": true },
        "register_is_not_identity": { "const": true },
        "task_role_is_not_persona": { "const": true },
        "historical_weight_is_not_model_weight": { "const": true },
        "token_efficiency_is_not_intelligence": { "const": true },
        "disagreement_is_not_deception": { "const": true },
        "silence_is_not_deception": { "const": true },
        "validation_is_not_truth": { "const": true },
        "civilisation_is_index_not_mind": { "const": true },
        "script_implies_language": { "const": false },
        "script_implies_identity": { "const": false },
        "corpus_frequency_implies_value": { "const": false },
        "attention_weight_is_explanation": { "const": false },
        "translation_is_identity": { "const": false },
        "agreement_is_truth": { "const": false }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "locator",
        "kind",
        "observed_on",
        "epistemic_access",
        "language_tags",
        "claim_scope",
        "limitations"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "locator": { "$ref": "#/$defs/externalOrRepoRef" },
        "kind": {
          "enum": [
            "primary-witness",
            "official-standard",
            "institutional-catalogue",
            "peer-reviewed-study",
            "scholarly-reference",
            "community-governance-source",
            "rights-instrument",
            "intergovernmental-guidance",
            "repo-contract"
          ]
        },
        "observed_on": { "$ref": "#/$defs/date" },
        "epistemic_access": { "const": "reported" },
        "language_tags": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2, "maxLength": 64 }
        },
        "claim_scope": { "$ref": "#/$defs/text" },
        "limitations": { "$ref": "#/$defs/stringList" }
      }
    },
    "historicalWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ecology",
        "period",
        "places",
        "language_varieties",
        "scripts",
        "media",
        "registers",
        "institutions",
        "contact_processes",
        "source_ids",
        "established",
        "contested_or_missing",
        "task_lessons",
        "civilisation_rank"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "ecology": { "$ref": "#/$defs/text" },
        "period": { "$ref": "#/$defs/text" },
        "places": { "$ref": "#/$defs/stringList" },
        "language_varieties": { "$ref": "#/$defs/stringList" },
        "scripts": { "$ref": "#/$defs/stringList" },
        "media": { "$ref": "#/$defs/stringList" },
        "registers": { "$ref": "#/$defs/stringList" },
        "institutions": { "$ref": "#/$defs/stringList" },
        "contact_processes": { "$ref": "#/$defs/stringList" },
        "source_ids": { "$ref": "#/$defs/idList" },
        "established": { "$ref": "#/$defs/stringList" },
        "contested_or_missing": { "$ref": "#/$defs/stringList" },
        "task_lessons": { "$ref": "#/$defs/stringList" },
        "civilisation_rank": { "type": "null" }
      }
    },
    "scriptProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iso_15924",
        "name",
        "direction",
        "unicode_version",
        "normalization_policy",
        "grapheme_policy",
        "layout_notes"
      ],
      "properties": {
        "iso_15924": { "type": "string", "pattern": "^[A-Z][a-z]{3}$" },
        "name": { "$ref": "#/$defs/shortText" },
        "direction": { "enum": ["ltr", "rtl", "vertical", "mixed", "historically-variable"] },
        "unicode_version": { "type": ["string", "null"], "maxLength": 32 },
        "normalization_policy": { "enum": ["preserve-exact-plus-nfc-view", "preserve-exact-no-normalized-view", "not-applicable"] },
        "grapheme_policy": { "enum": ["unicode-extended-grapheme-clusters", "script-tailored-review-required", "not-applicable"] },
        "layout_notes": { "$ref": "#/$defs/stringList" }
      }
    },
    "languageProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "endonym",
        "english_label",
        "bcp47",
        "family_note",
        "period_and_region",
        "variety",
        "scripts",
        "registers",
        "morphology_notes",
        "syntax_notes",
        "discourse_notes",
        "historical_roles",
        "source_ids",
        "community_review",
        "inherent_task_superiority"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "endonym": { "$ref": "#/$defs/shortText" },
        "english_label": { "$ref": "#/$defs/shortText" },
        "bcp47": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "family_note": { "$ref": "#/$defs/text" },
        "period_and_region": { "$ref": "#/$defs/text" },
        "variety": { "$ref": "#/$defs/shortText" },
        "scripts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/scriptProfile" }
        },
        "registers": { "$ref": "#/$defs/stringList" },
        "morphology_notes": { "$ref": "#/$defs/stringList" },
        "syntax_notes": { "$ref": "#/$defs/stringList" },
        "discourse_notes": { "$ref": "#/$defs/stringList" },
        "historical_roles": { "$ref": "#/$defs/stringList" },
        "source_ids": { "$ref": "#/$defs/idList" },
        "community_review": { "enum": ["required-before-publication", "recommended", "not-required-for-this-planned-fixture"] },
        "inherent_task_superiority": { "const": false }
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "definition", "status", "observables", "source_ids", "does_not_establish"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/shortText" },
        "definition": { "$ref": "#/$defs/text" },
        "status": { "enum": ["described", "reported", "not-run", "unknown"] },
        "observables": { "$ref": "#/$defs/stringList" },
        "source_ids": { "$ref": "#/$defs/optionalIdList" },
        "does_not_establish": { "$ref": "#/$defs/stringList" }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape", "weight", "aggregate_score", "ranking", "cross_axis_conversion"],
      "properties": {
        "shape": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": { "$ref": "#/$defs/dimension" }
        },
        "weight": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/dimension" }
        },
        "aggregate_score": { "type": "null" },
        "ranking": { "const": false },
        "cross_axis_conversion": { "const": false }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "statement",
        "scope",
        "source_ids",
        "status_checked_on",
        "limitations",
        "does_not_establish"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["historical-evidence", "llm-evidence", "standard", "design-choice", "boundary"] },
        "statement": { "$ref": "#/$defs/text" },
        "scope": { "$ref": "#/$defs/text" },
        "source_ids": { "$ref": "#/$defs/optionalIdList" },
        "status_checked_on": { "$ref": "#/$defs/date" },
        "limitations": { "$ref": "#/$defs/stringList" },
        "does_not_establish": { "$ref": "#/$defs/stringList" }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "scope", "violation_action"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statement": { "$ref": "#/$defs/text" },
        "scope": { "$ref": "#/$defs/text" },
        "violation_action": { "enum": ["stop", "retain-disagreement", "downgrade", "repair"] }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "state",
        "language_profile_ids",
        "register",
        "locator",
        "content_sha256",
        "attribution",
        "public_or_safely_redacted",
        "contains_private_reasoning",
        "source_bytes_retention_required"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["source-witness", "source-notes", "transcription", "normalized-view", "transliteration", "glossary", "translation", "draft", "critique", "test-report", "fused-output"] },
        "state": { "const": "planned" },
        "language_profile_ids": { "$ref": "#/$defs/idList" },
        "register": { "$ref": "#/$defs/shortText" },
        "locator": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/safeRef" }] },
        "content_sha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
        "attribution": { "$ref": "#/$defs/text" },
        "public_or_safely_redacted": { "const": true },
        "contains_private_reasoning": { "const": false },
        "source_bytes_retention_required": { "const": true }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "available" } }, "required": ["state"] },
          "then": {
            "properties": {
              "locator": { "$ref": "#/$defs/safeRef" },
              "content_sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        {
          "if": { "properties": { "state": { "enum": ["planned", "withdrawn"] } }, "required": ["state"] },
          "then": {
            "properties": {
              "locator": { "type": "null" },
              "content_sha256": { "type": "null" }
            }
          }
        }
      ]
    },
    "taskNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "instruction",
        "depends_on",
        "source_ids",
        "input_artifact_ids",
        "output_artifact_id",
        "run_card_id",
        "assignment_ids",
        "acceptance_test_ids",
        "public_artifacts_only",
        "status"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["source-read", "terminology-map", "draft", "critique", "verify", "fuse"] },
        "instruction": { "$ref": "#/$defs/text" },
        "depends_on": { "$ref": "#/$defs/optionalIdList" },
        "source_ids": { "$ref": "#/$defs/optionalIdList" },
        "input_artifact_ids": { "$ref": "#/$defs/optionalIdList" },
        "output_artifact_id": { "$ref": "#/$defs/id" },
        "run_card_id": { "$ref": "#/$defs/id" },
        "assignment_ids": { "$ref": "#/$defs/idList" },
        "acceptance_test_ids": { "$ref": "#/$defs/idList" },
        "public_artifacts_only": { "const": true },
        "status": { "const": "planned" }
      }
    },
    "taskGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "final_task_id", "final_artifact_id", "acyclic", "hidden_reasoning_edge_count"],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/taskNode" }
        },
        "final_task_id": { "$ref": "#/$defs/id" },
        "final_artifact_id": { "$ref": "#/$defs/id" },
        "acyclic": { "const": true },
        "hidden_reasoning_edge_count": { "const": 0 }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "task_id",
        "language_profile_id",
        "role",
        "selection_basis",
        "evidence_source_ids",
        "evaluation_test_id",
        "limitations",
        "historical_prestige_is_capability_evidence",
        "population_is_capability_evidence",
        "creates_identity_or_expertise"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "task_id": { "$ref": "#/$defs/id" },
        "language_profile_id": { "$ref": "#/$defs/id" },
        "role": { "enum": ["source-anchor", "terminology", "analysis", "draft", "translation", "critique", "verification", "audience-interface", "fusion"] },
        "selection_basis": { "enum": ["source-language", "requested-audience", "declared-terminology", "explicit-user-choice", "cross-language-check"] },
        "evidence_source_ids": { "$ref": "#/$defs/optionalIdList" },
        "evaluation_test_id": { "type": "null" },
        "limitations": { "$ref": "#/$defs/stringList" },
        "historical_prestige_is_capability_evidence": { "const": false },
        "population_is_capability_evidence": { "const": false },
        "creates_identity_or_expertise": { "const": false }
      }
    },
    "lossVector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phonology",
        "prosody",
        "morphology",
        "syntax",
        "polysemy",
        "register",
        "honorifics",
        "metaphor",
        "graphic_variation",
        "layout",
        "material_context",
        "provenance",
        "community_control"
      ],
      "properties": {
        "phonology": { "$ref": "#/$defs/lossState" },
        "prosody": { "$ref": "#/$defs/lossState" },
        "morphology": { "$ref": "#/$defs/lossState" },
        "syntax": { "$ref": "#/$defs/lossState" },
        "polysemy": { "$ref": "#/$defs/lossState" },
        "register": { "$ref": "#/$defs/lossState" },
        "honorifics": { "$ref": "#/$defs/lossState" },
        "metaphor": { "$ref": "#/$defs/lossState" },
        "graphic_variation": { "$ref": "#/$defs/lossState" },
        "layout": { "$ref": "#/$defs/lossState" },
        "material_context": { "$ref": "#/$defs/lossState" },
        "provenance": { "$ref": "#/$defs/lossState" },
        "community_control": { "$ref": "#/$defs/lossState" }
      }
    },
    "lossState": {
      "enum": ["preserved", "changed", "lost", "ambiguous", "untranslated", "not-tested", "not-applicable"]
    },
    "preservationTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant_id", "test_ids"],
      "properties": {
        "invariant_id": { "$ref": "#/$defs/id" },
        "test_ids": { "$ref": "#/$defs/idList" }
      }
    },
    "lossAxisTestIds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phonology",
