            "properties": {
              "model": { "type": "null" },
              "provider": { "type": "null" },
              "model_revision": { "type": "null" },
              "tokenizer": { "type": "null" },
              "tokenizer_revision": { "type": "null" },
              "prompt_revision": { "type": "null" },
              "run_on": { "type": "null" },
              "evidence_ref": { "type": "null" },
              "result_artifact_ids": { "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "run_status": { "enum": ["reported", "completed"] } }, "required": ["run_status"] },
          "then": {
            "properties": {
              "model": { "type": "string", "minLength": 1 },
