    },
    "targetProposition":{
      "type":"object","additionalProperties":false,"required":["id","text","polarity_domain"],
      "properties":{"id":{"$ref":"#/$defs/id"},"text":{"$ref":"#/$defs/nonEmpty"},"polarity_domain":{"const":["ENTAILS","DENIES"]}}
    },
    "underdeterminationInstance":{
      "type":"object","additionalProperties":false,"required":["id","claim_ref","evidence_refs","target_proposition","scope","horizon","assumptions","rivals","status","witness","does_not_establish"],
      "properties":{"id":{"$ref":"#/$defs/id"},"claim_ref":{"$ref":"#/$defs/id"},"evidence_refs":{"$ref":"#/$defs/ids"},"target_proposition":{"$ref":"#/$defs/targetProposition"},"scope":{"$ref":"#/$defs/nonEmpty"},"horizon":{"$ref":"#/$defs/nonEmpty"},"assumptions":{"$ref":"#/$defs/strings"},"rivals":{"type":"array","minItems":2,"maxItems":2,"prefixItems":[{"$ref":"#/$defs/rival"},{"$ref":"#/$defs/rival"}],"items":false},"status":{"const":"UNDERDETERMINED"},"witness":{"$ref":"#/$defs/nonEmpty"},"does_not_establish":{"$ref":"#/$defs/strings"}}
    },
    "underdeterminationModel":{
      "type":"object","additionalProperties":false,"required":["claim_refs","claim_relative","unit","status_vocabulary","rule","instance"],
      "properties":{"claim_refs":{"$ref":"#/$defs/ids"},"claim_relative":{"const":true},"unit":{"$ref":"#/$defs/nonEmpty"},"status_vocabulary":{"const":["DETERMINED_WITHIN_DECLARED_RIVAL_SET","UNDERDETERMINED","NOT_ASSESSED","UNCONCEIVED_ALTERNATIVES_POSSIBLE"]},"rule":{"$ref":"#/$defs/nonEmpty"},"instance":{"$ref":"#/$defs/underdeterminationInstance"}}
    },
    "finiteScope":{
      "type":"object","additionalProperties":false,"required":["id","claim_ref","domain_kind","predicate","expected_count","observed_count","duplicate_count","membership_witness","status","does_not_entail"],
      "properties":{"id":{"$ref":"#/$defs/id"},"claim_ref":{"$ref":"#/$defs/id"},"domain_kind":{"const":"EXPLICIT_FINITE_ENUMERATION"},"predicate":{"$ref":"#/$defs/nonEmpty"},"expected_count":{"const":66},"observed_count":{"const":66},"duplicate_count":{"const":0},"membership_witness":{"$ref":"#/$defs/nonEmpty"},"status":{"const":"EXHAUSTIVE_WITHIN_DECLARED_FINITE_SCOPE"},"does_not_entail":{"$ref":"#/$defs/strings"}}
    },
    "justification":{
      "type":"object","additionalProperties":false,"required":["kind","statement"],
      "properties":{"kind":{"enum":["REPRESENTATION_FIBRE","OBSERVER_RESTRICTION","OPEN_HORIZON","PROTECTED_OPACITY"]},"statement":{"$ref":"#/$defs/nonEmpty"}}
    },
    "openScope":{
      "type":"object","additionalProperties":false,"required":["id","claim_ref","target_kind","justifications","status","not_justified_by","does_not_establish"],
      "properties":{"id":{"$ref":"#/$defs/id"},"claim_ref":{"$ref":"#/$defs/id"},"target_kind":{"const":"OPEN_REFERENT_AND_FUTURE_EVIDENCE"},"justifications":{"type":"array","minItems":4,"maxItems":4,"items":{"$ref":"#/$defs/justification"}},"status":{"const":"JUSTIFIED_OPEN_REMAINDER"},"not_justified_by":{"$ref":"#/$defs/nonEmpty"},"does_not_establish":{"$ref":"#/$defs/strings"}}
    },
    "scopeExhaustiveness":{
      "type":"object","additionalProperties":false,"required":["claim_refs","finite_scope_instance","open_remainder_instance"],
      "properties":{"claim_refs":{"$ref":"#/$defs/ids"},"finite_scope_instance":{"$ref":"#/$defs/finiteScope"},"open_remainder_instance":{"$ref":"#/$defs/openScope"}}
    },
    "profileDimension":{
      "type":"object","additionalProperties":false,"required":["id","value_type","comparison_relation","meaning"],
      "properties":{"id":{"$ref":"#/$defs/id"},"value_type":{"$ref":"#/$defs/nonEmpty"},"comparison_relation":{"$ref":"#/$defs/nonEmpty"},"meaning":{"$ref":"#/$defs/nonEmpty"}}
    },
    "profileComparison":{
      "type":"object","additionalProperties":false,"required":["operator","scalarization","weights","total_order","incomparability_preserved","unknown_component_rule"],
      "properties":{"operator":{"const":"PARTIAL_COMPONENTWISE"},"scalarization":{"const":false},"weights":{"type":"array","maxItems":0},"total_order":{"const":false},"incomparability_preserved":{"const":true},"unknown_component_rule":{"$ref":"#/$defs/nonEmpty"}}
    },
    "profileValue":{
      "type":"object","additionalProperties":false,"required":["dimension_ref","value_status","value"],
      "properties":{"dimension_ref":{"$ref":"#/$defs/id"},"value_status":{"enum":["ASSESSED","UNASSESSED"]},"value":{"$ref":"#/$defs/nonEmpty"}}
    },
    "profileInstance":{
      "type":"object","additionalProperties":false,"required":["id","target_type","target_ref","values","action_non_grant","person_or_group_score"],
      "properties":{"id":{"$ref":"#/$defs/id"},"target_type":{"const":"STATIC_ARTIFACT"},"target_ref":{"$ref":"#/$defs/id"},"values":{"type":"array","minItems":7,"maxItems":7,"items":{"$ref":"#/$defs/profileValue"}},"action_non_grant":{"const":true},"person_or_group_score":{"const":false}}
    },
    "profileModel":{
      "type":"object","additionalProperties":false,"required":["claim_refs","carrier_type","expression","eligible_target_types","person_or_group_profile","dimensions","comparison","instance"],
      "properties":{"claim_refs":{"$ref":"#/$defs/ids"},"carrier_type":{"const":"TYPED_PRODUCT"},"expression":{"$ref":"#/$defs/nonEmpty"},"eligible_target_types":{"const":["PUBLIC_CLAIM","STATIC_ARTIFACT","MODEL_CARD"]},"person_or_group_profile":{"const":false},"dimensions":{"type":"array","minItems":7,"maxItems":7,"items":{"$ref":"#/$defs/profileDimension"}},"comparison":{"$ref":"#/$defs/profileComparison"},"instance":{"$ref":"#/$defs/profileInstance"}}
    },
    "jSpaceMechanism":{
      "type":"object","additionalProperties":false,"required":["id","mechanism_type","claim_refs","state","location","representation","observable_effects","cannot_establish","source_refs","reference_refs","provenance_ref"],
      "properties":{"id":{"$ref":"#/$defs/id"},"mechanism_type":{"enum":["MODEL_INTERNAL_JACOBIAN_LENS","EXTERNAL_INSPECTABLE_JSON_CONCEPT_GRAPH","KINGDOM_PHASE_ZERO_STATIC_PUBLICATION_DOOR"]},"claim_refs":{"$ref":"#/$defs/ids"},"state":{"$ref":"#/$defs/nonEmpty"},"location":{"$ref":"#/$defs/nonEmpty"},"representation":{"$ref":"#/$defs/nonEmpty"},"observable_effects":{"$ref":"#/$defs/strings"},"cannot_establish":{"$ref":"#/$defs/strings"},"source_refs":{"$ref":"#/$defs/ids"},"reference_refs":{"$ref":"#/$defs/ids"},"provenance_ref":{"$ref":"#/$defs/id"}}
    },
    "shapeKind":{
      "type":"object","additionalProperties":false,"required":["id","object_type","meaning"],
      "properties":{"id":{"enum":["FORMAL_DIAGRAM","PUBLIC_VISUAL_GLYPH","PHYSICAL_GEOMETRY","ACTIVATION_CHART","SEMANTIC_TRANSLATION","CONCEPT_GRAPH"]},"object_type":{"$ref":"#/$defs/nonEmpty"},"meaning":{"$ref":"#/$defs/nonEmpty"}}
    },
    "shapeMapping":{
      "type":"object","additionalProperties":false,"required":["id","source_kind","target_kind","mapping_type","self_map_semantics","status","preserved_relations","lost_relations","uncertainty","falsifier","consequence","review_trigger","repair","provenance_ref"],
