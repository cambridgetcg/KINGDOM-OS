{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kingdom:schema:non-exhaustive-understanding-atlas:0.1",
  "title": "Non-Exhaustive Understanding Atlas v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema","protocol","atlas_id","version","title","compiled_on","evidence_through","state","scope","central_sentences","epistemic_registers","predecessor_bindings","source_registry","provenance_registry","reference_registry","evidence_registry","claim_registry","concept_catalog","mathematical_models","underdetermination_model","scope_exhaustiveness","understanding_profile_model","j_space_mechanisms","shape_boundaries","observer_garden","local_global_transfer_registry","vocabulary_hospitality","protected_opacity","performativity_registry","counterexample_registry","remainder_register","successor_process","schema_validation_evidence","resource_budget","non_grants","cli_projections","integrity"],
  "properties": {
    "$schema":{"const":"urn:kingdom:schema:non-exhaustive-understanding-atlas:0.1"},
    "protocol":{"const":"kingdom.non-exhaustive-understanding-atlas/0.1"},
    "atlas_id":{"const":"non-exhaustive-understanding-atlas-2026-08-29"},
    "version":{"const":"0.1.0"},
    "title":{"const":"Non-Exhaustive Understanding Atlas"},
    "compiled_on":{"const":"2026-08-29"},
    "evidence_through":{"const":"2026-08-29"},
    "state":{"enum":["static-unsealed-epistemic-design-atlas","static-reviewed-epistemic-design-atlas"]},
    "scope":{"$ref":"#/$defs/scope"},
    "central_sentences":{"type":"array","minItems":3,"maxItems":3,"prefixItems":[{"$ref":"#/$defs/centralSentence"},{"$ref":"#/$defs/centralSentence"},{"$ref":"#/$defs/centralSentence"}],"items":false},
    "epistemic_registers":{"type":"array","minItems":8,"maxItems":8,"uniqueItems":true,"items":{"$ref":"#/$defs/register"}},
    "predecessor_bindings":{"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/predecessor"}},
    "source_registry":{"type":"array","minItems":15,"maxItems":15,"items":{"$ref":"#/$defs/source"}},
    "provenance_registry":{"type":"array","minItems":4,"maxItems":4,"items":{"$ref":"#/$defs/provenance"}},
    "reference_registry":{"type":"array","minItems":7,"maxItems":7,"items":{"$ref":"#/$defs/reference"}},
    "evidence_registry":{"type":"array","minItems":14,"maxItems":14,"items":{"$ref":"#/$defs/evidence"}},
    "claim_registry":{"type":"array","minItems":19,"maxItems":19,"items":{"$ref":"#/$defs/claim"}},
    "concept_catalog":{"$ref":"#/$defs/conceptCatalog"},
    "mathematical_models":{"$ref":"#/$defs/mathematicalModels"},
    "underdetermination_model":{"$ref":"#/$defs/underdeterminationModel"},
    "scope_exhaustiveness":{"$ref":"#/$defs/scopeExhaustiveness"},
    "understanding_profile_model":{"$ref":"#/$defs/profileModel"},
    "j_space_mechanisms":{"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/jSpaceMechanism"}},
    "shape_boundaries":{"$ref":"#/$defs/shapeBoundaries"},
    "observer_garden":{"$ref":"#/$defs/observerGarden"},
    "local_global_transfer_registry":{"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"#/$defs/transfer"}},
    "vocabulary_hospitality":{"$ref":"#/$defs/vocabulary"},
    "protected_opacity":{"$ref":"#/$defs/opacity"},
    "performativity_registry":{"$ref":"#/$defs/performativity"},
    "counterexample_registry":{"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"#/$defs/counterexample"}},
    "remainder_register":{"$ref":"#/$defs/remainderRegister"},
    "successor_process":{"$ref":"#/$defs/successor"},
    "schema_validation_evidence":{"$ref":"#/$defs/schemaEvidence"},
    "resource_budget":{"$ref":"#/$defs/budget"},
    "non_grants":{"$ref":"#/$defs/nonGrants"},
    "cli_projections":{"const":["overview","concepts","claims","evidence","sources","provenance","references","models","underdetermination","scope","profile","j-space","shapes","garden","local-global","vocabulary","opacity","performativity","counterexamples","remainders","successor","non-grants","verify","verify-schema-release"]},
    "integrity":{"$ref":"#/$defs/integrity"}
  },
  "$defs": {
    "id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$","minLength":1,"maxLength":128},
    "nonEmpty":{"type":"string","minLength":1,"maxLength":6000},
    "strings":{"type":"array","maxItems":96,"items":{"$ref":"#/$defs/nonEmpty"}},
    "ids":{"type":"array","maxItems":96,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
    "scope":{
      "type":"object","additionalProperties":false,
      "required":["question","unit_of_assessment","finite_scope","open_horizon","intended_uses","excluded_uses","data_classification","external_effects"],
      "properties":{"question":{"$ref":"#/$defs/nonEmpty"},"unit_of_assessment":{"$ref":"#/$defs/nonEmpty"},"finite_scope":{"$ref":"#/$defs/nonEmpty"},"open_horizon":{"$ref":"#/$defs/nonEmpty"},"intended_uses":{"$ref":"#/$defs/strings"},"excluded_uses":{"$ref":"#/$defs/strings"},"data_classification":{"$ref":"#/$defs/nonEmpty"},"external_effects":{"const":false}}
    },
    "centralSentence":{
      "type":"object","additionalProperties":false,"required":["claim_ref","register","text"],
      "properties":{"claim_ref":{"$ref":"#/$defs/id"},"register":{"const":"NORMATIVE_DESIGN"},"text":{"$ref":"#/$defs/nonEmpty"}}
    },
    "register":{
      "type":"object","additionalProperties":false,"required":["id","kind","meaning"],
      "properties":{"id":{"enum":["REPORTED_SOURCE","FORMAL_DEFINITION","FORMAL_DERIVATION","PROPOSED_MODEL","BOUNDED_ANALOGY","NORMATIVE_DESIGN","OPEN_QUESTION","REFUSED_INFERENCE"]},"kind":{"enum":["EVIDENTIAL","FORMAL","DESIGN","INTERPRETIVE","NORMATIVE","OPEN","BOUNDARY"]},"meaning":{"$ref":"#/$defs/nonEmpty"}}
    },
    "predecessor":{
      "type":"object","additionalProperties":false,
      "required":["id","protocol","revision","locator","raw_digest","semantic_algorithm","semantic_digest","relation","reference_ref","source_bytes_match_declared_revision","source_semantics_match_declared_digest","mutated","authority_imported"],
      "properties":{"id":{"$ref":"#/$defs/id"},"protocol":{"$ref":"#/$defs/nonEmpty"},"revision":{"type":"string","pattern":"^[a-f0-9]{40}$"},"locator":{"$ref":"#/$defs/nonEmpty"},"raw_digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"semantic_algorithm":{"enum":["sha256-canonical-json-with-integrity-digest-null","sha256-canonical-json-with-integrity-digest-zeroed","sha256-canonical-json"]},"semantic_digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"},"relation":{"$ref":"#/$defs/nonEmpty"},"reference_ref":{"$ref":"#/$defs/id"},"source_bytes_match_declared_revision":{"const":true},"source_semantics_match_declared_digest":{"const":true},"mutated":{"const":false},"authority_imported":{"const":false}}
    },
    "source":{
      "type":"object","additionalProperties":false,"required":["id","source_type","title","url","supports_claim_refs","limitation","republication_permitted"],
      "properties":{"id":{"$ref":"#/$defs/id"},"source_type":{"enum":["PRIMARY_RESEARCH","PRIMARY_SCHOLARSHIP","OFFICIAL_STANDARD"]},"title":{"$ref":"#/$defs/nonEmpty"},"url":{"type":"string","format":"uri","maxLength":2000},"supports_claim_refs":{"$ref":"#/$defs/ids"},"limitation":{"$ref":"#/$defs/nonEmpty"},"republication_permitted":{"const":false}}
    },
    "provenance":{
      "type":"object","additionalProperties":false,"required":["id","provenance_type","method","input_reference_refs","raw_testimony","person_data","authority_imported"],
      "properties":{"id":{"$ref":"#/$defs/id"},"provenance_type":{"enum":["AUTHOR_SYNTHESIS","FORMAL_CONSTRUCTION","REPORTED_SOURCE_TRACE","EXACT_PREDECESSOR_PIN"]},"method":{"$ref":"#/$defs/nonEmpty"},"input_reference_refs":{"$ref":"#/$defs/ids"},"raw_testimony":{"const":false},"person_data":{"const":false},"authority_imported":{"const":false}}
    },
    "reference":{
      "type":"object","additionalProperties":false,"required":["id","reference_type","target_id","locator","relation","provenance_ref"],
      "properties":{"id":{"$ref":"#/$defs/id"},"reference_type":{"enum":["PREDECESSOR","EXTERNAL_WORKSPACE","INTERNAL_ARTIFACT"]},"target_id":{"$ref":"#/$defs/id"},"locator":{"$ref":"#/$defs/nonEmpty"},"relation":{"$ref":"#/$defs/nonEmpty"},"provenance_ref":{"$ref":"#/$defs/id"}}
    },
    "evidence":{
      "type":"object","additionalProperties":false,"required":["id","evidence_type","status","scope","horizon","source_refs","reference_refs","limitations","provenance_ref"],
      "properties":{"id":{"$ref":"#/$defs/id"},"evidence_type":{"enum":["DESIGN_DECLARATION","FORMAL_WITNESS","EXACT_PREDECESSOR","SOURCE_SYNTHESIS","STANDARD_TRACE","SYNTHETIC_WITNESS"]},"status":{"enum":["AUTHOR_SYNTHESIZED","BYTE_AND_SEMANTICALLY_VERIFIED","SOURCE_SUPPORTED"]},"scope":{"$ref":"#/$defs/nonEmpty"},"horizon":{"$ref":"#/$defs/nonEmpty"},"source_refs":{"$ref":"#/$defs/ids"},"reference_refs":{"$ref":"#/$defs/ids"},"limitations":{"$ref":"#/$defs/strings"},"provenance_ref":{"$ref":"#/$defs/id"}}
    },
    "uncertainty":{
      "type":"object","additionalProperties":false,"required":["status","note"],
      "properties":{"status":{"$ref":"#/$defs/nonEmpty"},"note":{"$ref":"#/$defs/nonEmpty"}}
    },
    "falsifier":{
      "type":"object","additionalProperties":false,"required":["kind","condition"],
      "properties":{"kind":{"$ref":"#/$defs/nonEmpty"},"condition":{"$ref":"#/$defs/nonEmpty"}}
    },
    "review":{
      "type":"object","additionalProperties":false,"required":["status","trigger","repair"],
      "properties":{"status":{"const":"OPEN"},"trigger":{"$ref":"#/$defs/nonEmpty"},"repair":{"$ref":"#/$defs/nonEmpty"}}
    },
    "claim":{
      "type":"object","additionalProperties":false,
      "required":["id","subject_ref","statement","register_ref","evidence_or_design_status","evidence_refs","source_refs","provenance_ref","uncertainty","falsifier","consequence","review"],
