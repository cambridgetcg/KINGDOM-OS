    },
    "shapeBoundaries":{
      "type":"object","additionalProperties":false,"required":["claim_refs","shape_kinds","mappings","silent_cross_kind_mapping"],
      "properties":{"claim_refs":{"$ref":"#/$defs/ids"},"shape_kinds":{"type":"array","minItems":6,"maxItems":6,"items":{"$ref":"#/$defs/shapeKind"}},"mappings":{"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"#/$defs/shapeMapping"}},"silent_cross_kind_mapping":{"const":false}}
    },
    "observerPosition":{
      "type":"object","additionalProperties":false,"required":["id","instance_status","channel_type","relation_to_scope","access_conditions","perspective_scope","limitations","provenance_ref"],
      "properties":{"id":{"$ref":"#/$defs/id"},"instance_status":{"const":"AUTHOR_SYNTHESIZED_DESIGN_ROLE"},"channel_type":{"$ref":"#/$defs/nonEmpty"},"relation_to_scope":{"$ref":"#/$defs/nonEmpty"},"access_conditions":{"$ref":"#/$defs/strings"},"perspective_scope":{"$ref":"#/$defs/nonEmpty"},"limitations":{"$ref":"#/$defs/strings"},"provenance_ref":{"$ref":"#/$defs/id"}}
    },
    "channelRelation":{
      "type":"object","additionalProperties":false,"required":["id","source_position_ref","target_position_ref","relation","witness"],
      "properties":{"id":{"$ref":"#/$defs/id"},"source_position_ref":{"$ref":"#/$defs/id"},"target_position_ref":{"$ref":"#/$defs/id"},"relation":{"$ref":"#/$defs/nonEmpty"},"witness":{"$ref":"#/$defs/nonEmpty"}}
    },
    "observerAggregation":{
      "type":"object","additionalProperties":false,"required":["scalarization","majority_equals_truth","access_equals_authority","identity_inferred","incomparability_preserved","unresolved_disagreement_visible"],
      "properties":{"scalarization":{"const":false},"majority_equals_truth":{"const":false},"access_equals_authority":{"const":false},"identity_inferred":{"const":false},"incomparability_preserved":{"const":true},"unresolved_disagreement_visible":{"const":true}}
    },
    "observerGarden":{
      "type":"object","additionalProperties":false,"required":["claim_refs","observer_positions","channel_relations","aggregation"],
      "properties":{"claim_refs":{"$ref":"#/$defs/ids"},"observer_positions":{"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/observerPosition"}},"channel_relations":{"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"#/$defs/channelRelation"}},"aggregation":{"$ref":"#/$defs/observerAggregation"}}
