    "preservationWitness":{
      "type":"object","additionalProperties":false,"required":["id","relation","source_unit_refs","target_unit_refs","status"],
      "properties":{"id":{"$ref":"#/$defs/id"},"relation":{"$ref":"#/$defs/nonEmpty"},"source_unit_refs":{"$ref":"#/$defs/ids"},"target_unit_refs":{"$ref":"#/$defs/ids"},"status":{"const":"WITNESSED"}}
