    },
    "family":{
      "type":"object","additionalProperties":false,"required":["id","label","concept_ids"],
      "properties":{"id":{"$ref":"#/$defs/id"},"label":{"$ref":"#/$defs/nonEmpty"},"concept_ids":{"type":"array","minItems":4,"maxItems":9,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}}}
    },
    "concept":{
      "type":"object","additionalProperties":false,"required":["id","family_id","concept_type","definition","register_ref","claim_refs","nonclaims","provenance_ref"],
      "properties":{"id":{"$ref":"#/$defs/id"},"family_id":{"$ref":"#/$defs/id"},"concept_type":{"type":"string","pattern":"^[A-Z0-9_]+$","maxLength":96},"definition":{"$ref":"#/$defs/nonEmpty"},"register_ref":{"enum":["REPORTED_SOURCE","FORMAL_DEFINITION","FORMAL_DERIVATION","PROPOSED_MODEL","BOUNDED_ANALOGY","NORMATIVE_DESIGN","OPEN_QUESTION","REFUSED_INFERENCE"]},"claim_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"nonclaims":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/nonEmpty"}},"provenance_ref":{"$ref":"#/$defs/id"}}
    },
    "conceptCatalog":{
      "type":"object","additionalProperties":false,"required":["count","family_count","families","concepts"],
      "properties":{"count":{"const":66},"family_count":{"const":10},"families":{"type":"array","minItems":10,"maxItems":10,"items":{"$ref":"#/$defs/family"}},"concepts":{"type":"array","minItems":66,"maxItems":66,"items":{"$ref":"#/$defs/concept"}}}
    },
    "mathModel":{
      "type":"object","additionalProperties":false,"required":["claim_refs","expression","interpretation"],
      "properties":{"claim_refs":{"$ref":"#/$defs/ids"},"expression":{"$ref":"#/$defs/nonEmpty"},"interpretation":{"$ref":"#/$defs/nonEmpty"}}
    },
    "mathematicalModels":{
      "type":"object","additionalProperties":false,"required":["representation_fibre","task_relative_sufficiency","decision_deficiency","observer_preorder","claim_relative_nonidentifiability","local_global_gluing"],
