    "artifactContentUnit":{
      "type":"object","additionalProperties":false,"required":["id","text"],
      "properties":{"id":{"$ref":"#/$defs/id"},"text":{"$ref":"#/$defs/nonEmpty"}}
    },
    "transferArtifact":{
