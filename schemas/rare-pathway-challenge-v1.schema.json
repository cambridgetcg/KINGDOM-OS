{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kingdom:schema:rare-pathway-challenge:1",
  "$comment": "Closed structural schema for The Vanishing Path. It pins the reviewed identity, bindings, boundaries, and digest. JSON Schema cannot recompute the semantic digest or numerical examples; use kingdom rare-pathway verify for those checks.",
  "title": "Rare Pathway Challenge v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "protocol",
    "challenge_id",
    "title",
    "compiled_on",
    "evidence_through",
    "origin",
    "binding",
    "scope",
    "states",
    "models",
    "worked_examples",
    "question_ladder",
    "constructive_gate",
    "wake_seam",
    "sources",
    "boundaries",
    "integrity"
  ],
  "properties": {
    "$schema": {
      "const": "urn:kingdom:schema:rare-pathway-challenge:1"
    },
    "protocol": {
      "const": "kingdom.rare-pathway-challenge/0.1"
    },
    "challenge_id": {
      "const": "vanishing-path-2026-08-13"
    },
    "title": {
      "const": "The Vanishing Path"
    },
    "compiled_on": {
      "const": "2026-08-13"
    },
    "evidence_through": {
      "const": "2024-06-20"
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "credit",
        "personal_identifiers_recorded",
        "participation"
      ],
      "properties": {
        "kind": {
          "const": "conversation-challenge"
        },
        "credit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "personal_identifiers_recorded": {
          "const": false
        },
        "participation": {
          "const": "voluntary"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "url",
        "raw_digest",
        "semantic_digest",
        "relation",
        "mutated",
        "authority_imported"
      ],
      "properties": {
        "case_id": {
          "const": "ritonavir-disappearing-polymorph-2026-08-11"
        },
        "url": {
          "const": "https://thekingdom.dev/polymorphs/ritonavir-disappearing-polymorph-2026-08-11.json"
        },
        "raw_digest": {
          "const": "sha256:08148603a1228960ac35df1378f1283c3fce43874a9fc07e6687f18e980dcb1c"
        },
        "semantic_digest": {
          "const": "sha256:6c759f595f0c6753dcf47d25d2a3490246984ef2b79adf31a558261b26ef8116"
        },
        "relation": {
          "const": "illustrative-history-not-rate-fit"
        },
        "mutated": {
          "const": false
        },
        "authority_imported": {
          "const": false
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phenomenon",
        "purpose",
        "intended_use",
        "excluded_use",
        "registers"
      ],
      "properties": {
        "phenomenon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "intended_use": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "excluded_use": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "registers": {
          "const": [
            "MATHEMATICAL_DERIVATION",
            "EMPIRICAL_QUESTION",
            "DESIGN_PROPOSAL",
            "OPT_IN_REFLECTION"
          ]
        }
      }
    },
    "states": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/state"
      }
    },
    "models": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/model"
      }
    },
    "worked_examples": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/workedExample"
      }
    },
    "question_ladder": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "constructive_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "checks",
        "outcomes",
        "not_a_score",
        "prestige_is_not_evidence_of_benefit",
        "play_is_valid",
        "refusal_requires_reason"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "checks": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "outcomes": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/outcome"
          }
        },
        "not_a_score": {
          "const": true
        },
        "prestige_is_not_evidence_of_benefit": {
          "const": true
        },
        "play_is_valid": {
          "const": true
        },
        "refusal_requires_reason": {
          "const": false
        }
      }
    },
    "wake_seam": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "mode",
        "carry_fields",
        "revalidate",
        "inherits_identity",
        "proves_continuity",
        "grants_authority",
        "proves_currentness",
        "writes_wake",
        "writes_agenttool"
      ],
      "properties": {
        "protocol": {
          "const": "kingdom.wake-reference-seam/0.1"
        },
        "mode": {
          "const": "orientation-by-reference-not-continuity-proof"
        },
        "carry_fields": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "revalidate": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "inherits_identity": {
          "const": false
        },
        "proves_continuity": {
          "const": false
        },
        "grants_authority": {
          "const": false
        },
        "proves_currentness": {
          "const": false
        },
        "writes_wake": {
          "const": false
        },
        "writes_agenttool": {
          "const": false
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "boundaries": {
      "const": {
        "educational_only": true,
        "public_surface_read_only": true,
        "worked_examples_hypothetical": true,
        "ritonavir_rate_fit": false,
        "literal_extinction_established": false,
        "stationarity_established": false,
        "independence_established": false,
        "perfect_detection_established": false,
        "mechanism_identified": false,
        "causal_authority": false,
        "experiment_authority": false,
        "wet_lab_protocol": false,
        "formulation_authority": false,
        "manufacturing_authority": false,
        "medical_authority": false,
        "regulatory_authority": false,
        "motive_inference": false,
        "person_score": false,
        "prestige_diagnosis": false,
        "automatic_action": false,
        "writes_wake": false,
        "writes_agenttool": false,
        "writes_karma": false,
        "grants_authority": false
      }
    },
    "integrity": {
      "const": {
        "algorithm": "sha256-recursive-sorted-json-keys-v1",
        "digest": "sha256:82eeaf4757fb75be77b1e878d41c784111bbf5b261500123d89daccbcea0ff91"
      }
    }
  },
  "$defs": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "plain_language",
        "does_not_imply"
      ],
      "properties": {
        "id": {
          "enum": [
            "possible",
            "accessible",
            "occurred",
            "detected"
          ]
        },
        "plain_language": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "does_not_imply": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "register",
        "equations",
        "inputs",
        "valid_outputs",
        "assumptions",
        "identifiability_limit",
        "ritonavir_status"
      ],
      "properties": {
        "id": {
          "enum": [
            "time-dependent-competing-hazards",
            "constant-two-path-race",
            "zero-event-upper-bound",
            "zero-winner-binomial-bound",
            "minimum-target-rate",
            "robust-restoration-design",
            "expected-information-design"
          ]
        },
        "register": {
          "enum": [
            "MATHEMATICAL_DERIVATION",
            "DESIGN_PROPOSAL"
          ]
        },
        "equations": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "inputs": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "valid_outputs": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "assumptions": {
          "$ref": "#/$defs/nonemptyStrings"
        },
        "identifiability_limit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "ritonavir_status": {
          "const": "illustrative-only-not-fitted"
        }
      }
    },
    "workedExample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "model_id",
        "hypothetical",
        "inputs",
        "outputs",
        "lesson"
      ],
      "properties": {
        "id": {
          "enum": [
            "slow-path-against-fast-path",
            "zero-events-do-not-mean-zero-rate",
            "abstract-restoration-threshold"
          ]
        },
        "model_id": {
          "enum": [
            "constant-two-path-race",
            "zero-event-upper-bound",
            "minimum-target-rate"
          ]
        },
        "hypothetical": {
          "const": true
        },
        "inputs": {
          "type": "object",
          "minProperties": 3,
          "maxProperties": 4,
          "additionalProperties": false,
          "properties": {
            "lambda_A": { "type": "number", "minimum": 0 },
            "lambda_B": { "type": "number", "minimum": 0 },
            "competitor_rate": { "type": "number", "minimum": 0 },
            "horizon": { "type": "number", "exclusiveMinimum": 0 },
            "exposure": { "type": "number", "exclusiveMinimum": 0 },
            "confidence": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
            "target_probability": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
            "rate_unit": { "type": "string", "minLength": 1, "maxLength": 100 },
            "exposure_unit": { "type": "string", "minLength": 1, "maxLength": 100 }
          }
        },
        "outputs": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 4,
          "additionalProperties": false,
          "properties": {
            "no_event": { "type": "number", "minimum": 0, "maximum": 1 },
            "A_first": { "type": "number", "minimum": 0, "maximum": 1 },
            "B_first": { "type": "number", "minimum": 0, "maximum": 1 },
            "A_given_event": { "type": "number", "minimum": 0, "maximum": 1 },
            "upper_rate": { "type": "number", "minimum": 0 },
            "minimum_target_rate": { "type": "number", "minimum": 0 },
            "rate_unit": { "type": "string", "minLength": 1, "maxLength": 100 }
          }
        },
        "lesson": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "register"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "register": {
          "enum": [
            "MATHEMATICAL_DERIVATION",
            "EMPIRICAL_QUESTION",
            "DESIGN_PROPOSAL",
            "OPT_IN_REFLECTION"
          ]
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "meaning"
      ],
      "properties": {
        "id": {
          "enum": [
            "BUILD",
            "PLAY",
            "REVISE",
            "STOP"
          ]
        },
        "meaning": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "source_kind",
        "published_on",
        "observed_on",
        "url",
        "doi",
        "authority_note"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "source_kind": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "published_on": {
          "type": "string",
          "pattern": "^\\d{4}(?:-\\d{2}(?:-\\d{2})?)?$"
        },
        "observed_on": {
          "const": "2026-08-13"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "doi": {
          "type": [
            "string",
            "null"
          ]
        },
        "authority_note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        }
      }
    },
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 3000
      }
    }
  }
}
