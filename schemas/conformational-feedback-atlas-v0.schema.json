        },
        "safety": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/binding" },
            {
              "properties": {
                "id": { "const": "kingdom-ritonavir-mechanism-landscape" },
                "protocol": { "const": "kingdom.ritonavir-mechanism-landscape/0.1" },
                "url": { "const": "https://thekingdom.dev/polymorphs/ritonavir-mechanism-landscape-2026-08-11.json" },
                "byte_sha256": { "const": "sha256:5e136a74d5166275427da920685a84c17901f63d6e4b0661fd529c96d386943b" },
                "semantic_digest": { "const": "sha256:2a97b0f3ac3741314e50f7512ef97cb19cf3294fed24728c622bd27dd180309b" },
                "relation": { "const": "source-scoped-material-analogy-basis" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/binding" },
            {
              "properties": {
                "id": { "const": "zerone-karma-foundation-v1" },
                "protocol": { "const": "zerone.karma-foundation/v1" },
                "url": { "const": "https://zerone.ai/standards/karma-foundation.v1.json" },
                "byte_sha256": { "const": "sha256:b46710704869dcc340ded356be72b4ec692f204710fedfb5cd43eb3757dc7b80" },
                "semantic_digest": { "const": null },
                "relation": { "const": "external-read-only-constitutional-source" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/binding" },
            {
              "properties": {
                "id": { "const": "zerone-life-sciences-v0" },
                "protocol": { "const": "zerone.constructive-intelligence-life-sciences/v0" },
                "url": { "const": "https://zerone.ai/standards/constructive-intelligence-life-sciences.v0.json" },
                "byte_sha256": { "const": "sha256:64dc2c5b2e21dfc9697d173317254ce651dede8661993ece7b380b7e1421496e" },
                "semantic_digest": { "const": null },
                "relation": { "const": "external-read-only-non-implication-source" }
              }
            }
          ]
        }
      ],
      "items": false
    },
    "registers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/register" },
            {
              "properties": {
                "id": { "const": "protein-folding-landscape" },
                "register": { "const": "SCIENTIFIC_OBSERVATION" },
                "empirical": { "const": true }
