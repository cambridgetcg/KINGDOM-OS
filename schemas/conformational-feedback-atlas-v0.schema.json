    "feedback_path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meaning",
        "stages",
        "exit"
      ],
      "properties": {
        "meaning": {
          "$ref": "#/$defs/text"
        },
        "stages": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            { "$ref": "#/$defs/feedbackStage", "properties": { "id": { "const": "artifact-exists" } } },
            { "$ref": "#/$defs/feedbackStage", "properties": { "id": { "const": "contextual-observation" } } },
            { "$ref": "#/$defs/feedbackStage", "properties": { "id": { "const": "challenge-or-repair" } } },
            { "$ref": "#/$defs/feedbackStage", "properties": { "id": { "const": "bounded-consultation" } } }
          ],
          "items": false
        },
        "exit": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "philosophy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "register",
        "proposition",
        "basis_ids",
        "does_not_establish",
        "empirical",
        "causal_transfer",
        "authority_effect"
      ],
      "properties": {
        "register": {
          "const": "PHILOSOPHY"
        },
        "proposition": {
          "$ref": "#/$defs/text"
        },
        "basis_ids": {
          "type": "array",
          "maxItems": 0
        },
        "does_not_establish": {
          "$ref": "#/$defs/nonInferences"
        },
        "empirical": {
          "const": false
        },
        "causal_transfer": {
          "const": false
        },
        "authority_effect": {
          "const": "NONE"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "prefixItems": [
        { "$ref": "#/$defs/source", "properties": { "id": { "const": "anfinsen-1973" } } },
        { "$ref": "#/$defs/source", "properties": { "id": { "const": "bryngelson-1995" } } },
        { "$ref": "#/$defs/source", "properties": { "id": { "const": "chernoff-1995" } } },
        { "$ref": "#/$defs/source", "properties": { "id": { "const": "serio-2000" } } },
        { "$ref": "#/$defs/source", "properties": { "id": { "const": "tanaka-2004" } } },
        { "$ref": "#/$defs/source", "properties": { "id": { "const": "knowles-2009" } } },
        { "$ref": "#/$defs/source", "properties": { "id": { "const": "kmiecik-2020" } } },
        { "$ref": "#/$defs/source", "properties": { "id": { "const": "manka-2022" } } },
        { "$ref": "#/$defs/source", "properties": { "id": { "const": "kingdom-ritonavir-mechanism-source" } } },
        { "$ref": "#/$defs/source", "properties": { "id": { "const": "zerone-karma-foundation-v1-source" } } },
        { "$ref": "#/$defs/source", "properties": { "id": { "const": "zerone-life-sciences-v0-source" } } }
