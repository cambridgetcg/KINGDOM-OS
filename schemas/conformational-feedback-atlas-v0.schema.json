      ],
      "items": false
    },
    "geometries": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/geometry" },
            { "properties": { "id": { "const": "rugged-landscape" }, "register": { "const": "SCIENTIFIC_OBSERVATION" } } }
