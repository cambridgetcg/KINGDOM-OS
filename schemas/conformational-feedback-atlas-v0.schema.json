{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kingdom:schema:conformational-feedback-atlas:0.1",
  "title": "KINGDOM Conformational Feedback Atlas v0",
  "description": "A closed, read-only contract that keeps source-scoped science, Zerone constitutional design, analogy, and philosophy non-equivalent.",
  "$comment": "The fixed digest identifies the reviewed artifact. JSON Schema cannot recompute the recursive-sorted semantic digest; use kingdom feedback verify for that independent check.",
