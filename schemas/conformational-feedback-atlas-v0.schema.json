  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 96
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "https": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "idList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "nonInferences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "feedbackStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "optional",
        "automatic_effect"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "optional": {
          "const": true
        },
        "automatic_effect": {
          "const": false
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "protocol",
        "url",
        "byte_sha256",
        "semantic_digest",
        "relation",
        "mutated",
        "authority_imported"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "protocol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "url": {
          "$ref": "#/$defs/https"
        },
        "byte_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "semantic_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "relation": {
          "$ref": "#/$defs/id"
        },
        "mutated": {
          "const": false
        },
        "authority_imported": {
          "const": false
        }
      }
    },
    "register": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "register",
        "label",
        "context",
        "statement",
        "basis_ids",
        "does_not_establish",
        "empirical",
        "causal_transfer",
        "authority_effect"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "register": {
          "enum": [
            "SCIENTIFIC_OBSERVATION",
            "CONSTITUTIONAL_DESIGN"
          ]
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "context": {
          "$ref": "#/$defs/text"
        },
        "statement": {
          "$ref": "#/$defs/text"
        },
        "basis_ids": {
          "$ref": "#/$defs/idList"
        },
        "does_not_establish": {
          "$ref": "#/$defs/nonInferences"
        },
        "empirical": {
          "type": "boolean"
        },
        "causal_transfer": {
          "const": false
        },
        "authority_effect": {
          "const": "NONE"
        },
        "karma_constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "summable",
            "rank_effect",
            "economic_effect",
            "governance_effect",
            "person_level"
          ],
          "properties": {
            "summable": {
              "const": false
            },
            "rank_effect": {
              "const": false
            },
            "economic_effect": {
              "const": false
            },
            "governance_effect": {
              "const": false
            },
            "person_level": {
              "const": false
            }
          }
        }
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "register",
        "shape",
        "maps_to",
        "basis_ids",
        "does_not_establish"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "register": {
          "enum": [
            "SCIENTIFIC_OBSERVATION",
            "CONSTITUTIONAL_DESIGN"
          ]
        },
        "shape": {
          "$ref": "#/$defs/text"
        },
        "maps_to": {
          "$ref": "#/$defs/text"
        },
        "basis_ids": {
          "$ref": "#/$defs/idList"
        },
        "does_not_establish": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "register",
        "observation",
        "translation",
        "basis_ids",
        "forbidden_inference",
        "empirical",
        "causal_transfer",
        "authority_effect"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "register": {
          "const": "ANALOGY"
        },
        "observation": {
          "$ref": "#/$defs/text"
        },
        "translation": {
          "$ref": "#/$defs/text"
        },
        "basis_ids": {
          "$ref": "#/$defs/idList"
        },
        "forbidden_inference": {
          "$ref": "#/$defs/text"
        },
        "empirical": {
          "const": false
        },
        "causal_transfer": {
          "const": false
        },
        "authority_effect": {
          "const": "NONE"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "url",
        "doi",
        "supports"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "primary-paper",
            "primary-synthesis",
            "bound-public-record",
            "bound-public-standard"
          ]
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "url": {
          "$ref": "#/$defs/https"
        },
        "doi": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 6,
              "maxLength": 160
            },
            {
              "type": "null"
            }
          ]
        },
        "supports": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
