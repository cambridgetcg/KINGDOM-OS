          "const": false
        },
        "prion_models_people": {
          "const": false
        },
        "karma_is_biological": {
          "const": false
        },
        "karma_summable": {
          "const": false
        },
        "karma_rank_effect": {
          "const": false
        },
        "karma_economic_effect": {
          "const": false
        },
        "karma_governance_effect": {
          "const": false
