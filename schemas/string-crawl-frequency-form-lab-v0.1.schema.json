{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thekingdom.dev/schemas/string-crawl-frequency-form-lab/0.1.json",
  "$comment": "Closed structural contract for a synthetic offline frequency/form/world/presence thought experiment. Schema validity does not establish empirical accuracy, causation, a portal, an external entity, a physical extra dimension, medical authority, or KARMA.",
  "title": "KINGDOM STRAND Lab 03 v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "protocol", "lab_id", "version", "title", "subtitle", "mode",
    "predecessor", "conventions", "temporal_fixture", "spatial_fixture",
    "quantity_register", "pairwise_quantity_relations", "occurrence_fixture",
    "dimension_register", "presence_evidence_ladder", "ordering_contract",
    "release_slices", "features", "observations", "transitions", "frontiers",
    "cospans", "composition_check", "evidence_cards", "nonimplication_firewall",
    "effect_boundary", "karma_lanes", "validation_contract", "expected", "integrity"
  ],
  "properties": {
    "$schema": { "const": "https://thekingdom.dev/schemas/string-crawl-frequency-form-lab/0.1.json" },
    "protocol": { "const": "kingdom.string-crawl-frequency-form-lab/0.1" },
    "lab_id": { "const": "string-crawl-frequency-form-lab-03-2026-08-16" },
    "version": { "const": "0.1.0" },
    "title": { "const": "STRAND Lab 03: Frequency → Form → World → Other" },
    "subtitle": { "const": "Three Frequencies, Four Dimensions & the False Portal" },
    "mode": { "const": "SYNTHETIC_OFFLINE_EXACT" },
    "predecessor": { "$ref": "#/$defs/predecessor" },
    "conventions": { "$ref": "#/$defs/conventions" },
    "temporal_fixture": { "$ref": "#/$defs/temporalFixture" },
    "spatial_fixture": { "$ref": "#/$defs/spatialFixture" },
    "quantity_register": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": { "$ref": "#/$defs/quantity" }
    },
    "pairwise_quantity_relations": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": { "$ref": "#/$defs/quantityRelation" }
    },
    "occurrence_fixture": { "$ref": "#/$defs/occurrenceFixture" },
    "dimension_register": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": { "$ref": "#/$defs/dimensionEntry" }
    },
    "presence_evidence_ladder": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": { "$ref": "#/$defs/presenceEvidence" }
    },
    "ordering_contract": { "$ref": "#/$defs/orderingContract" },
    "release_slices": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": { "$ref": "#/$defs/releaseSlice" }
    },
    "features": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": { "$ref": "#/$defs/feature" }
    },
    "observations": {
      "type": "array", "minItems": 12, "maxItems": 12,
      "items": { "$ref": "#/$defs/observation" }
    },
    "transitions": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "items": { "$ref": "#/$defs/transition" }
    },
    "frontiers": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": { "$ref": "#/$defs/frontier" }
    },
    "cospans": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": { "$ref": "#/$defs/cospan" }
    },
    "composition_check": { "$ref": "#/$defs/compositionCheck" },
    "evidence_cards": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "items": { "$ref": "#/$defs/evidenceCard" }
    },
    "nonimplication_firewall": {
      "type": "array", "minItems": 17, "maxItems": 17,
      "items": { "$ref": "#/$defs/nonimplication" }
    },
    "effect_boundary": { "$ref": "#/$defs/effectBoundary" },
    "karma_lanes": { "$ref": "#/$defs/karmaLanes" },
    "validation_contract": { "$ref": "#/$defs/validationContract" },
    "expected": { "$ref": "#/$defs/expected" },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "$defs": {
    "id": {
      "type": "string", "minLength": 1, "maxLength": 180,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "upperToken": {
      "type": "string", "minLength": 1, "maxLength": 180,
      "pattern": "^[A-Z0-9]+(?:[_-][A-Z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "idArray": {
      "type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "integerVector4": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": { "type": "integer", "minimum": -16, "maximum": 16 }
    },
    "matrix4x3": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "array", "minItems": 3, "maxItems": 3,
        "items": { "type": "integer", "minimum": -4, "maximum": 4 }
      }
    },
    "matrix4x4": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "array", "minItems": 4, "maxItems": 4,
        "items": { "type": "integer", "minimum": -8, "maximum": 8 }
      }
    },
    "rational": {
      "type": "object", "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "denominator": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    },
    "predecessor": {
      "type": "object", "additionalProperties": false,
      "required": [
        "protocol", "lab_id", "url", "schema_url", "guide_url", "git_commit",
        "semantic_digest", "byte_sha256", "schema_byte_sha256",
        "guide_byte_sha256", "relation", "mutates_predecessor", "imports_authority"
      ],
      "properties": {
        "protocol": { "const": "kingdom.string-crawl-strand-lab/0.1" },
        "lab_id": { "const": "string-crawl-strand-lab-02-2026-08-16" },
        "url": { "const": "https://thekingdom.dev/labs/string-crawl-strand-lab-02-2026-08-16.json" },
        "schema_url": { "const": "https://thekingdom.dev/schemas/string-crawl-strand-lab/0.1.json" },
        "guide_url": { "const": "https://thekingdom.dev/STRING-CRAWL-STRAND-LAB-02.md" },
        "git_commit": { "const": "2bd03fd77226775a58eff382011e43f26512d733" },
        "semantic_digest": { "const": "sha256:cb07f3408cee01b0b465fa9ee543257e4d38e9cfddc203e47b4c8d429bcc3a1c" },
        "byte_sha256": { "const": "sha256:9aa56248ed6bdda8da4fd177617b87b2f5e3d5d1a657fedbb5059acb43b4b429" },
        "schema_byte_sha256": { "const": "sha256:6387cc7e2152f3e1e45c0dfb10eb6f14f22fbcdc933918bfed2c5ebea5866fb4" },
        "guide_byte_sha256": { "const": "sha256:34256139d0f630278b0e9baf9688b04aaab09945e97b0901a9ee273787b1ea41" },
        "relation": { "const": "IMMUTABLE_LAB_02_PREDECESSOR" },
        "mutates_predecessor": { "const": false },
        "imports_authority": { "const": false }
      }
    },
    "conventions": {
      "type": "object", "additionalProperties": false,
      "required": [
        "tick_count", "tick_unit", "temporal_transform", "temporal_frequency_unit",
        "spatial_operator", "spatial_mode_unit", "signed_incidence",
        "spectrum_order", "spectrum_absolute_tolerance",
        "selected_eigenvector_is_representative_not_canonical",
        "eigenvector_global_sign_is_not_canonical", "spatial_repertoire_measure",
        "spatial_repertoire_is_sign_invariant", "missing_value_state",
        "zero_is_observed_value", "ordering_interpretation",
        "equal_numerals_cross_types_are_comparable",
        "candidate_text_is_data_not_instruction", "witnesses_are_authoritative"
      ],
      "properties": {
        "tick_count": { "const": 64 },
        "tick_unit": { "const": "SYNTHETIC_TICK" },
        "temporal_transform": { "const": "UNNORMALIZED_FORWARD_DFT_NEGATIVE_PHASE" },
        "temporal_frequency_unit": { "const": "CYCLES_PER_SYNTHETIC_TICK" },
        "spatial_operator": { "const": "COMBINATORIAL_GRAPH_LAPLACIAN_BBT" },
        "spatial_mode_unit": { "const": "GRAPH_LAPLACIAN_EIGENVALUE" },
        "signed_incidence": { "const": "TAIL_MINUS_ONE_HEAD_PLUS_ONE" },
        "spectrum_order": { "const": "NONDECREASING_EIGENVALUE" },
        "spectrum_absolute_tolerance": { "const": 1e-12 },
        "selected_eigenvector_is_representative_not_canonical": { "const": true },
        "eigenvector_global_sign_is_not_canonical": { "const": true },
        "spatial_repertoire_measure": { "const": "ORDERED_EIGENPROJECTOR_ENERGY_PROBABILITY" },
        "spatial_repertoire_is_sign_invariant": { "const": true },
        "missing_value_state": { "const": "MISSING_WITH_NULL" },
        "zero_is_observed_value": { "const": true },
        "ordering_interpretation": { "const": "ORDER_ONLY_NOT_CAUSAL" },
        "equal_numerals_cross_types_are_comparable": { "const": false },
        "candidate_text_is_data_not_instruction": { "const": true },
        "witnesses_are_authoritative": { "const": false }
      }
    },
    "temporalFixture": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "sample_count", "samples", "quadrature_samples",
        "physical_sample_interval_seconds", "physical_sample_rate_hz",
        "hertz_conversion"
      ],
      "properties": {
        "id": { "const": "temporal-wave-64" },
        "sample_count": { "const": 64 },
        "samples": {
          "type": "array", "minItems": 64, "maxItems": 64,
          "items": { "enum": [-1, 0, 1] }
        },
        "quadrature_samples": {
          "type": "array", "minItems": 64, "maxItems": 64,
          "items": { "enum": [-1, 0, 1] }
        },
        "physical_sample_interval_seconds": { "type": "null" },
        "physical_sample_rate_hz": { "type": "null" },
        "hertz_conversion": { "const": "UNDEFINED" }
      }
    },
    "incidenceOccurrence": {
      "type": "object", "additionalProperties": false,
      "required": ["vertex_id", "coefficient"],
      "properties": {
        "vertex_id": { "$ref": "#/$defs/id" },
        "coefficient": { "enum": [-1, 1] }
      }
    },
    "orientedEdge": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "tail", "head", "incidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "tail": { "$ref": "#/$defs/id" },
        "head": { "$ref": "#/$defs/id" },
        "incidence": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": { "$ref": "#/$defs/incidenceOccurrence" }
        }
      }
    },
    "spatialFixture": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "vertices", "oriented_edges", "selected_mode", "spatial_signal",
        "declared_mode_probabilities"
      ],
      "properties": {
        "id": { "const": "spatial-path-four" },
        "vertices": {
          "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "oriented_edges": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": { "$ref": "#/$defs/orientedEdge" }
        },
        "selected_mode": { "$ref": "#/$defs/integerVector4" },
        "spatial_signal": { "$ref": "#/$defs/integerVector4" },
        "declared_mode_probabilities": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": { "$ref": "#/$defs/rational" }
        }
      }
    },
    "quantity": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "kind", "domain", "carrier", "operator", "estimator",
        "display_value", "normalized_value", "unit", "scale", "window",
        "sampling_frame", "uncertainty", "significance_rule",
        "physical_quantity", "population_prevalence"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "$ref": "#/$defs/upperToken" },
        "domain": { "$ref": "#/$defs/upperToken" },
        "carrier": { "$ref": "#/$defs/upperToken" },
        "operator": { "$ref": "#/$defs/upperToken" },
        "estimator": { "$ref": "#/$defs/upperToken" },
        "display_value": { "type": "number", "minimum": 0, "maximum": 10000 },
        "normalized_value": { "type": "number", "minimum": 0, "maximum": 10000 },
        "unit": { "$ref": "#/$defs/upperToken" },
        "scale": { "$ref": "#/$defs/upperToken" },
        "window": { "$ref": "#/$defs/upperToken" },
        "sampling_frame": { "$ref": "#/$defs/upperToken" },
        "uncertainty": { "$ref": "#/$defs/upperToken" },
        "significance_rule": { "$ref": "#/$defs/upperToken" },
        "physical_quantity": { "const": false },
        "population_prevalence": { "const": false }
      }
    },
    "quantityRelation": {
      "type": "object", "additionalProperties": false,
      "required": ["left", "right", "relation", "same_numeral_means_same_quantity"],
      "properties": {
        "left": { "$ref": "#/$defs/id" },
        "right": { "$ref": "#/$defs/id" },
        "relation": { "const": "NO_CANONICAL_CONVERSION" },
        "same_numeral_means_same_quantity": { "const": false }
      }
    },
    "occurrenceFixture": {
      "type": "object", "additionalProperties": false,
      "required": [
        "source_card_id", "selected_experience_count", "selected_post_count",
        "coded_entity_experience_count", "coding_unit", "reported_percentage_tenths",
        "coding_rule", "sampling_frame",
        "population_prevalence", "per_session_probability",
        "external_entity_detection"
      ],
      "properties": {
        "source_card_id": { "const": "lawrence-2022" },
        "selected_experience_count": { "const": 3778 },
        "selected_post_count": { "const": 3305 },
        "coded_entity_experience_count": { "const": 1719 },
        "coding_unit": { "const": "SOURCE_DEFINED_EXPERIENCE" },
        "reported_percentage_tenths": { "const": 455 },
        "coding_rule": { "const": "SOURCE_REPORTED_ENTITY_ENCOUNTER_CATEGORY" },
        "sampling_frame": { "const": "SOURCE_SELECTED_EXPERIENCES_FROM_SELF_POSTED_REDDIT_POSTS" },
        "population_prevalence": { "const": false },
        "per_session_probability": { "const": false },
        "external_entity_detection": { "const": false }
      }
    },
    "dimensionEntry": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "kind", "status", "definition", "estimator_or_theorem",
        "unit", "uncertainty", "sampling_scope", "physical_spacetime_claim",
        "conversion_to_physical_dimension"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "$ref": "#/$defs/upperToken" },
        "status": { "$ref": "#/$defs/upperToken" },
        "definition": { "$ref": "#/$defs/upperToken" },
        "estimator_or_theorem": { "$ref": "#/$defs/upperToken" },
        "unit": { "$ref": "#/$defs/upperToken" },
        "uncertainty": { "$ref": "#/$defs/upperToken" },
        "sampling_scope": { "$ref": "#/$defs/upperToken" },
        "physical_spacetime_claim": { "const": false },
        "conversion_to_physical_dimension": {
          "enum": ["NO_CANONICAL_CONVERSION", "NOT_APPLICABLE"]
        }
      }
    },
    "presenceEvidence": {
      "type": "object", "additionalProperties": false,
      "required": [
        "order", "kind", "state", "protocol", "scope", "present_here",
        "imports_next_level"
      ],
      "properties": {
        "order": { "type": "integer", "minimum": 0, "maximum": 3 },
        "kind": { "$ref": "#/$defs/upperToken" },
        "state": { "enum": ["PRESENT", "ABSENT", "MISSING", "NOT_MEASURED"] },
        "protocol": { "$ref": "#/$defs/upperToken" },
        "scope": { "$ref": "#/$defs/upperToken" },
        "present_here": { "type": "boolean" },
        "imports_next_level": { "const": false }
      },
      "allOf": [
        {
          "if": { "properties": { "present_here": { "const": true } } },
          "then": { "properties": { "state": { "const": "PRESENT" } } }
        },
        {
          "if": { "properties": { "present_here": { "const": false } } },
          "then": { "properties": { "state": { "const": "NOT_MEASURED" } } }
        }
      ]
    },
    "orderingContract": {
      "type": "object", "additionalProperties": false,
      "required": [
        "relation", "onset_definition", "present_zero_counts_as_present",
        "missing_is_absent", "arrows_establish_causation",
        "arrows_establish_ontology"
      ],
      "properties": {
        "relation": { "const": "ORDER_ONLY_NOT_CAUSAL" },
        "onset_definition": { "const": "MINIMUM_RELEASE_ORDER_WITH_PRESENT_STATE" },
        "present_zero_counts_as_present": { "const": true },
        "missing_is_absent": { "const": false },
        "arrows_establish_causation": { "const": false },
        "arrows_establish_ontology": { "const": false }
      }
    },
    "releaseSlice": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "order"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "order": { "type": "integer", "minimum": 0, "maximum": 2 }
      }
    },
    "feature": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "layer", "born_in", "evidence_kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "layer": { "$ref": "#/$defs/upperToken" },
        "born_in": { "$ref": "#/$defs/id" },
        "evidence_kind": { "const": "SYNTHETIC_MARKER" }
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "slice_id", "feature_id", "state", "value"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "slice_id": { "$ref": "#/$defs/id" },
        "feature_id": { "$ref": "#/$defs/id" },
        "state": { "enum": ["PRESENT", "MISSING"] },
        "value": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": -16, "maximum": 16 }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "MISSING" } } },
          "then": { "properties": { "value": { "type": "null" } } },
          "else": { "properties": { "value": { "type": "integer" } } }
        }
      ]
    },
    "boundaryOccurrence": {
      "type": "object", "additionalProperties": false,
      "required": ["observation_id", "coefficient"],
      "properties": {
        "observation_id": { "$ref": "#/$defs/id" },
        "coefficient": { "enum": [-1, 1] }
      }
    },
    "transition": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "feature_id", "from_observation_id", "to_observation_id", "boundary"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "feature_id": { "$ref": "#/$defs/id" },
        "from_observation_id": { "$ref": "#/$defs/id" },
        "to_observation_id": { "$ref": "#/$defs/id" },
        "boundary": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": { "$ref": "#/$defs/boundaryOccurrence" }
        }
      }
    },
    "frontier": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "slice_id", "observation_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "slice_id": { "$ref": "#/$defs/id" },
        "observation_ids": {
          "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "cospan": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "input_frontier_id", "output_frontier_id",
        "observation_ids", "transition_ids"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "input_frontier_id": { "$ref": "#/$defs/id" },
        "output_frontier_id": { "$ref": "#/$defs/id" },
        "observation_ids": {
          "type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "transition_ids": {
          "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "compositionCheck": {
      "type": "object", "additionalProperties": false,
      "required": [
        "left_cospan_id", "right_cospan_id", "shared_frontier_id",
        "restriction_rule", "gluing_rule", "expected_intersection",
        "expected_glued_counts", "passes"
      ],
      "properties": {
        "left_cospan_id": { "$ref": "#/$defs/id" },
        "right_cospan_id": { "$ref": "#/$defs/id" },
        "shared_frontier_id": { "$ref": "#/$defs/id" },
        "restriction_rule": { "const": "EXACT_SLICE_RESTRICTION" },
        "gluing_rule": { "const": "EXACT_OBSERVATION_ID_PUSHOUT" },
        "expected_intersection": {
          "type": "object", "additionalProperties": false,
          "required": ["observation_ids", "transition_ids"],
          "properties": {
            "observation_ids": { "$ref": "#/$defs/idArray" },
            "transition_ids": {
              "type": "array", "maxItems": 8, "uniqueItems": true,
              "items": { "$ref": "#/$defs/id" }
            }
          }
        },
        "expected_glued_counts": {
          "type": "object", "additionalProperties": false,
          "required": ["observations", "transitions"],
          "properties": {
            "observations": { "type": "integer", "minimum": 0, "maximum": 32 },
            "transitions": { "type": "integer", "minimum": 0, "maximum": 32 }
          }
        },
        "passes": { "const": true }
      }
    },
    "evidenceCard": {
      "type": "object", "additionalProperties": false,
      "required": [
        "id", "year", "title", "doi", "url", "register",
        "bounded_support", "design_scope_limit", "does_not_establish",
        "participant_data_ingested"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "year": { "type": "integer", "minimum": 1900, "maximum": 2026 },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "doi": { "type": "string", "minLength": 1, "maxLength": 160 },
        "url": {
          "type": "string", "minLength": 1, "maxLength": 240,
          "pattern": "^https://doi[.]org/"
        },
        "register": { "$ref": "#/$defs/upperToken" },
        "bounded_support": { "type": "string", "minLength": 1, "maxLength": 600 },
