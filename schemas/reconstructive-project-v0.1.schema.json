      "type": "object", "additionalProperties": false, "required": ["created_on", "created_by", "source_ids", "previous_version", "notes"],
      "properties": { "created_on": { "type": "string", "format": "date" }, "created_by": { "$ref": "#/$defs/text" }, "source_ids": { "$ref": "#/$defs/ids" }, "previous_version": { "oneOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] }, "notes": { "$ref": "#/$defs/texts" } }
