    "release": {
      "type": "object", "additionalProperties": false, "required": ["status", "artifact_url", "byte_sha256", "deployed", "deployment_authority"],
      "properties": { "status": { "enum": ["DRAFT", "REVIEWED", "RELEASED", "RETIRED"] }, "artifact_url": { "oneOf": [{ "type": "string", "format": "uri", "pattern": "^https://" }, { "type": "null" }] }, "byte_sha256": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }, "deployed": { "const": false }, "deployment_authority": { "const": false } }
    },
    "boundaries": {
      "type": "object", "additionalProperties": false,
      "required": ["read_only", "design_infrastructure_only", "solver_included", "project_execution", "project_deployment", "external_write", "biological_mechanism_transfer", "physical_parameter_transfer", "medical_authority", "experiment_authority", "wet_lab_protocol", "person_scoring", "writes_karma", "creates_karma_receipt", "economic_effect", "governance_effect", "automatic_action", "runtime_network_request"],
      "properties": { "read_only": { "const": true }, "design_infrastructure_only": { "const": true }, "solver_included": { "const": false }, "project_execution": { "const": false }, "project_deployment": { "const": false }, "external_write": { "const": false }, "biological_mechanism_transfer": { "const": false }, "physical_parameter_transfer": { "const": false }, "medical_authority": { "const": false }, "experiment_authority": { "const": false }, "wet_lab_protocol": { "const": false }, "person_scoring": { "const": false }, "writes_karma": { "const": false }, "creates_karma_receipt": { "const": false }, "economic_effect": { "const": false }, "governance_effect": { "const": false }, "automatic_action": { "const": false }, "runtime_network_request": { "const": false } }
    },
    "integrity": {
      "type": "object", "additionalProperties": false, "required": ["algorithm", "digest"],
      "properties": { "algorithm": { "const": "sha256-recursive-sorted-json-keys-v1" }, "digest": { "$ref": "#/$defs/digest" } }
    }
  }
}
