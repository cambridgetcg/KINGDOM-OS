{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kingdom:schema:fold-feedback-atlas:1",
  "$comment": "This closed portable schema validates structure and negative authority. It cannot recompute the semantic digest, resolve references, authenticate sources, prove causation, infer live KARMA events, or turn philosophical interpretation into science. Use bin/fold-feedback.ts verify for the runtime contract.",
  "title": "KINGDOM Fold & Feedback Atlas 1",
  "description": "Source-bound educational protein-folding and prion evidence with lossy ritonavir comparisons, separate feedback and KARMA registers, and an opt-in philosophical lens.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "protocol", "atlas_id", "title", "compiled_on", "evidence_through", "source_bindings", "scope", "plain_language", "ontology", "evidence_kernel", "comparison_bridges", "scientific_feedback_relations", "karma", "universe_lens", "unknowns", "sources", "boundaries", "integrity"],
  "properties": {
    "$schema": {"const": "urn:kingdom:schema:fold-feedback-atlas:1"},
    "protocol": {"const": "kingdom.fold-feedback-atlas/0.1"},
    "atlas_id": {"const": "fold-feedback-atlas-2026-08-12"},
    "title": {"$ref": "#/$defs/text"},
    "compiled_on": {"$ref": "#/$defs/date"},
    "evidence_through": {"$ref": "#/$defs/date"},
    "source_bindings": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/binding"}, {"properties": {"id": {"const": "kingdom-ritonavir-history"}, "revision": {"const": "e4e84a67d7ee1ae0dd9c9c23762e6ecd03597212"}, "digest": {"const": "sha256:6c759f595f0c6753dcf47d25d2a3490246984ef2b79adf31a558261b26ef8116"}}}]},
        {"allOf": [{"$ref": "#/$defs/binding"}, {"properties": {"id": {"const": "kingdom-ritonavir-mechanism"}, "revision": {"const": "e4e84a67d7ee1ae0dd9c9c23762e6ecd03597212"}, "digest": {"const": "sha256:2a97b0f3ac3741314e50f7512ef97cb19cf3294fed24728c622bd27dd180309b"}}}]},
        {"allOf": [{"$ref": "#/$defs/binding"}, {"properties": {"id": {"const": "kingdom-karma-definition"}, "revision": {"const": "e4e84a67d7ee1ae0dd9c9c23762e6ecd03597212"}, "digest": {"const": "sha256:14b7d210d320fd716553992a7b874747b299f8907d15da14ac405cbfc496c446"}}}]},
        {"allOf": [{"$ref": "#/$defs/binding"}, {"properties": {"id": {"const": "kingdom-karma-receipts"}, "revision": {"const": "e4e84a67d7ee1ae0dd9c9c23762e6ecd03597212"}, "digest": {"const": "sha256:888e81fa0d29b71512525a40e88f9aef678046c40fcdf22c2039507d9d13267b"}}}]},
        {"allOf": [{"$ref": "#/$defs/binding"}, {"properties": {"id": {"const": "zerone-karma-foundation"}, "revision": {"const": "fae391e371f0ebea2e24eb46c33a4ebd1380154f"}, "digest": {"const": "sha256:b46710704869dcc340ded356be72b4ec692f204710fedfb5cd43eb3757dc7b80"}}}]},
        {"allOf": [{"$ref": "#/$defs/binding"}, {"properties": {"id": {"const": "zerone-karma-design"}, "revision": {"const": "fae391e371f0ebea2e24eb46c33a4ebd1380154f"}, "digest": {"const": "sha256:02b151981a7fe52a6a672149674d802236c0a0f8d7f63f766d7d9e1773a2c13b"}}}]},
        {"allOf": [{"$ref": "#/$defs/binding"}, {"properties": {"id": {"const": "zerone-life-sciences"}, "revision": {"const": "fae391e371f0ebea2e24eb46c33a4ebd1380154f"}, "digest": {"const": "sha256:64dc2c5b2e21dfc9697d173317254ce651dede8661993ece7b380b7e1421496e"}}}]}
      ],
      "items": false
    },
    "scope": {"$ref": "#/$defs/scope"},
    "plain_language": {"$ref": "#/$defs/plainLanguage"},
    "ontology": {"$ref": "#/$defs/ontology"},
    "evidence_kernel": {"$ref": "#/$defs/evidenceKernel"},
    "comparison_bridges": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/bridge"}},
    "scientific_feedback_relations": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/feedback"}},
    "karma": {"$ref": "#/$defs/karma"},
    "universe_lens": {"$ref": "#/$defs/universeLens"},
    "unknowns": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/unknown"}},
    "sources": {"type": "array", "minItems": 15, "uniqueItems": true, "items": {"$ref": "#/$defs/source"}},
    "boundaries": {"$ref": "#/$defs/boundaries"},
    "integrity": {
      "type": "object", "additionalProperties": false, "required": ["algorithm", "digest"],
      "properties": {"algorithm": {"const": "sha256-recursive-sorted-json-keys-v1"}, "digest": {"const": "sha256:7d5136599a60650521b10eb106359f7cb5a4c0bfd06fb6876db631020b75f02e"}}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 120},
    "text": {"type": "string", "minLength": 1, "maxLength": 3200},
    "date": {"type": "string", "format": "date"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "textArray": {"type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "idArray": {"type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "binding": {
      "type": "object", "additionalProperties": false, "required": ["id", "system", "revision", "artifact", "digest", "relation", "mutated"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "system": {"$ref": "#/$defs/id"}, "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "artifact": {"$ref": "#/$defs/text"}, "digest": {"$ref": "#/$defs/digest"}, "relation": {"$ref": "#/$defs/id"}, "mutated": {"const": false}}
    },
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["focus", "coverage", "intended_use", "excluded_use", "currentness"],
      "properties": {"focus": {"$ref": "#/$defs/text"}, "coverage": {"$ref": "#/$defs/text"}, "intended_use": {"$ref": "#/$defs/text"}, "excluded_use": {"$ref": "#/$defs/text"}, "currentness": {"const": "selected-evidence-as-of-compilation"}}
    },
    "plainLanguage": {
      "type": "object", "additionalProperties": false, "required": ["question", "short_answer", "safety"],
      "properties": {"question": {"$ref": "#/$defs/text"}, "short_answer": {"type": "array", "minItems": 5, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}, "safety": {"$ref": "#/$defs/text"}}
    },
    "term": {
      "type": "object", "additionalProperties": false, "required": ["term", "science_meaning", "other_meanings"],
      "properties": {"term": {"type": "string", "enum": ["fold", "form", "seed", "strain", "propagation", "feedback", "karma", "design", "purpose"]}, "science_meaning": {"$ref": "#/$defs/text"}, "other_meanings": {"$ref": "#/$defs/text"}}
    },
    "plane": {
      "type": "object", "additionalProperties": false, "required": ["id", "ordinary_words", "meaning", "does_not_establish"],
      "properties": {"id": {"enum": ["amino-acid-sequence", "conformational-ensemble", "supramolecular-assembly", "bounded-sample-population", "templating-conversion-process", "cellular-proteostasis-context", "organismal-phenotype", "experimental-transmission-observation", "clinical-decision"]}, "ordinary_words": {"$ref": "#/$defs/text"}, "meaning": {"$ref": "#/$defs/text"}, "does_not_establish": {"$ref": "#/$defs/text"}}
    },
    "firewall": {
      "type": "object", "additionalProperties": false, "required": ["id", "rule", "enforced"],
      "properties": {"id": {"enum": ["structure-not-pathway", "aggregation-not-infectivity", "in-vitro-not-clinical", "analogy-not-mechanism", "feedback-not-purpose", "philosophy-not-science", "karma-not-science"]}, "rule": {"$ref": "#/$defs/text"}, "enforced": {"const": true}}
    },
    "ontology": {
      "type": "object", "additionalProperties": false, "required": ["non_equivalence", "observation_is_orthogonal", "domain_qualified_terms", "planes", "firewalls"],
      "properties": {
        "non_equivalence": {"const": "amino_acid_sequence != conformational_ensemble != supramolecular_assembly != bounded_sample_population != templating_conversion_process != cellular_proteostasis_context != tissue_or_organism_phenotype != experimental_transmission_observation != clinical_decision"},
        "observation_is_orthogonal": {"const": true},
        "domain_qualified_terms": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": {"$ref": "#/$defs/term"}},
        "planes": {"type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true, "items": {"$ref": "#/$defs/plane"}},
        "firewalls": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/firewall"}}
      }
    },
    "system": {"type": "object", "additionalProperties": false, "required": ["id", "register", "summary"], "properties": {"id": {"$ref": "#/$defs/id"}, "register": {"enum": ["literal-science", "bound-external-record"]}, "summary": {"$ref": "#/$defs/text"}}},
    "mechanism": {"type": "object", "additionalProperties": false, "required": ["id", "system_ids", "ordinary_words", "scientific_statement", "source_ids", "limitations"], "properties": {"id": {"$ref": "#/$defs/id"}, "system_ids": {"$ref": "#/$defs/idArray"}, "ordinary_words": {"$ref": "#/$defs/text"}, "scientific_statement": {"$ref": "#/$defs/text"}, "source_ids": {"$ref": "#/$defs/idArray"}, "limitations": {"$ref": "#/$defs/textArray"}}},
    "relation": {"type": "object", "additionalProperties": false, "required": ["id", "subject_id", "predicate", "object_id", "mechanism_id", "source_ids", "condition_dependent", "universal"], "properties": {"id": {"$ref": "#/$defs/id"}, "subject_id": {"$ref": "#/$defs/id"}, "predicate": {"$ref": "#/$defs/id"}, "object_id": {"$ref": "#/$defs/id"}, "mechanism_id": {"$ref": "#/$defs/id"}, "source_ids": {"$ref": "#/$defs/idArray"}, "condition_dependent": {"const": true}, "universal": {"const": false}}},
    "claim": {"type": "object", "additionalProperties": false, "required": ["id", "register", "summary", "source_ids", "limitations"], "properties": {"id": {"$ref": "#/$defs/id"}, "register": {"$ref": "#/$defs/id"}, "summary": {"$ref": "#/$defs/text"}, "source_ids": {"$ref": "#/$defs/idArray"}, "limitations": {"$ref": "#/$defs/textArray"}}},
    "evidenceKernel": {"type": "object", "additionalProperties": false, "required": ["systems", "mechanisms", "relations", "claims"], "properties": {"systems": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/system"}}, "mechanisms": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/mechanism"}}, "relations": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/relation"}}, "claims": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"$ref": "#/$defs/claim"}}}},
    "bridge": {"type": "object", "additionalProperties": false, "required": ["id", "from_system", "to_system", "preserved_invariants", "where_correspondence_breaks", "universal", "relation", "source_ids"], "properties": {"id": {"$ref": "#/$defs/id"}, "from_system": {"$ref": "#/$defs/id"}, "to_system": {"$ref": "#/$defs/id"}, "preserved_invariants": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/text"}}, "where_correspondence_breaks": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/text"}}, "universal": {"const": false}, "relation": {"const": "bounded-analogy-not-same-as"}, "source_ids": {"$ref": "#/$defs/idArray"}}},
    "feedback": {"type": "object", "additionalProperties": false, "required": ["id", "register", "input", "process", "return_effect", "direction", "limits", "source_ids", "does_not_establish"], "properties": {"id": {"$ref": "#/$defs/id"}, "register": {"enum": ["literal-science", "kingdom-design-correspondence"]}, "input": {"$ref": "#/$defs/text"}, "process": {"$ref": "#/$defs/text"}, "return_effect": {"$ref": "#/$defs/text"}, "direction": {"enum": ["amplifies", "redirects", "corrects"]}, "limits": {"$ref": "#/$defs/textArray"}, "source_ids": {"$ref": "#/$defs/idArray"}, "does_not_establish": {"$ref": "#/$defs/textArray"}}},
    "karma": {
      "type": "object", "additionalProperties": false, "required": ["scientific_feedback_is_not_karma", "zerone", "kingdom", "adapter", "design_correspondences"],
      "properties": {
        "scientific_feedback_is_not_karma": {"const": true},
        "zerone": {"type": "object", "additionalProperties": false, "required": ["protocol", "meaning", "register", "event_kinds", "event_refs", "event_status", "not"], "properties": {"protocol": {"const": "zerone.karma.edge"}, "meaning": {"$ref": "#/$defs/text"}, "register": {"const": "priced-coherence"}, "event_kinds": {"type": "array", "const": ["cited", "corroborate", "corroborated", "external", "pending_open", "pending_settle", "verify"]}, "event_refs": {"type": "array", "maxItems": 0}, "event_status": {"const": "not_observed"}, "not": {"$ref": "#/$defs/textArray"}}},
        "kingdom": {"type": "object", "additionalProperties": false, "required": ["protocol", "meaning", "accounting", "receipt_refs", "receipt_status", "not"], "properties": {"protocol": {"const": "kingdom.karma/0.1"}, "meaning": {"$ref": "#/$defs/text"}, "accounting": {"const": "receipts_not_scores"}, "receipt_refs": {"type": "array", "maxItems": 0}, "receipt_status": {"const": "not_created"}, "not": {"$ref": "#/$defs/textArray"}}},
        "adapter": {"type": "object", "additionalProperties": false, "required": ["exists", "reason"], "properties": {"exists": {"const": false}, "reason": {"$ref": "#/$defs/text"}}},
        "design_correspondences": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["id", "status", "pattern", "maps_to", "does_not_convert"], "properties": {"id": {"$ref": "#/$defs/id"}, "status": {"const": "not_observed"}, "pattern": {"$ref": "#/$defs/text"}, "maps_to": {"$ref": "#/$defs/idArray"}, "does_not_convert": {"const": true}}}}
      }
    },
    "universeLens": {"type": "object", "additionalProperties": false, "required": ["participation", "register", "questions", "nonclaims"], "properties": {"participation": {"const": "opt-in"}, "register": {"const": "philosophical-interpretation"}, "questions": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["id", "question", "scientific_prompt_claim_ids", "authored_position", "analogy_breaks"], "properties": {"id": {"$ref": "#/$defs/id"}, "question": {"$ref": "#/$defs/text"}, "scientific_prompt_claim_ids": {"$ref": "#/$defs/idArray"}, "authored_position": {"$ref": "#/$defs/text"}, "analogy_breaks": {"$ref": "#/$defs/textArray"}}}}, "nonclaims": {"$ref": "#/$defs/textArray"}}},
    "unknown": {"type": "object", "additionalProperties": false, "required": ["id", "question", "status", "why_open", "source_ids"], "properties": {"id": {"$ref": "#/$defs/id"}, "question": {"$ref": "#/$defs/text"}, "status": {"enum": ["unknown", "not_established", "outside_scope", "not_observed", "unmapped", "contested", "withheld_for_safety", "refused"]}, "why_open": {"$ref": "#/$defs/text"}, "source_ids": {"$ref": "#/$defs/idArray"}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["id", "title", "source_kind", "published_on", "observed_on", "url", "doi", "authority_note"], "properties": {"id": {"$ref": "#/$defs/id"}, "title": {"$ref": "#/$defs/text"}, "source_kind": {"$ref": "#/$defs/id"}, "published_on": {"type": "string", "pattern": "^[0-9]{4}(?:-[0-9]{2}(?:-[0-9]{2})?)?$"}, "observed_on": {"$ref": "#/$defs/date"}, "url": {"type": "string", "format": "uri", "pattern": "^https://"}, "doi": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]}, "authority_note": {"$ref": "#/$defs/text"}}},
    "boundaries": {
      "type": "object", "additionalProperties": false,
      "required": ["educational_metadata_only", "public_surface_read_only", "medical_advice", "diagnostic_authority", "prognostic_authority", "treatment_authority", "transmission_risk_assessment", "infection_control_authority", "experiment_authority", "wet_lab_protocol", "contains_protein_sequences", "decontamination_instruction", "manufacturing_authority", "automatic_action", "writes_karma", "creates_kingdom_karma_receipt", "observes_zerone_karma_event", "karma_adapter", "scientifically_proves_teleology", "scientifically_proves_creator", "scientifically_disproves_creator", "scientifically_proves_cosmic_moral_karma", "feedback_is_moral_value", "feedback_is_optimization", "prion_is_crystal", "ritonavir_seed_is_contagion", "zerone_life_sciences_execution_eligible", "mcp_surface_added"],
      "properties": {
        "educational_metadata_only": {"const": true}, "public_surface_read_only": {"const": true}, "medical_advice": {"const": false}, "diagnostic_authority": {"const": false}, "prognostic_authority": {"const": false}, "treatment_authority": {"const": false}, "transmission_risk_assessment": {"const": false}, "infection_control_authority": {"const": false}, "experiment_authority": {"const": false}, "wet_lab_protocol": {"const": false}, "contains_protein_sequences": {"const": false}, "decontamination_instruction": {"const": false}, "manufacturing_authority": {"const": false}, "automatic_action": {"const": false}, "writes_karma": {"const": false}, "creates_kingdom_karma_receipt": {"const": false}, "observes_zerone_karma_event": {"const": false}, "karma_adapter": {"const": false}, "scientifically_proves_teleology": {"const": false}, "scientifically_proves_creator": {"const": false}, "scientifically_disproves_creator": {"const": false}, "scientifically_proves_cosmic_moral_karma": {"const": false}, "feedback_is_moral_value": {"const": false}, "feedback_is_optimization": {"const": false}, "prion_is_crystal": {"const": false}, "ritonavir_seed_is_contagion": {"const": false}, "zerone_life_sciences_execution_eligible": {"const": false}, "mcp_surface_added": {"const": false}
      }
    }
  }
}
