            "properties": {
              "value": { "not": { "type": "null" } },
              "reason": { "type": "null" },
              "falsifier": { "type": "string", "minLength": 1 }
            },
            "anyOf": [
              { "properties": { "support_refs": { "minItems": 1 } } },
              { "properties": { "opposition_refs": { "minItems": 1 } } }
            ]
          }
        },
        {
          "if": { "properties": { "cell_status": { "const": "UNRESOLVED" } } },
          "then": {
            "properties": {
              "value": { "type": "null" },
              "reason": { "type": "string", "minLength": 1 },
              "support_refs": { "maxItems": 0 },
              "opposition_refs": { "maxItems": 0 },
              "falsifier": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "cell_status": { "const": "NOT_APPLICABLE" } } },
