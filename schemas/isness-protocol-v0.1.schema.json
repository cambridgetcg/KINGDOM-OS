{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kingdom:schema:isness-protocol:0.1",
  "title": "KINGDOM ISness Record 0.1",
  "description": "A closed typed partial observation checkpoint with declared predecessor lineage. Schema validity establishes neither prior history, content-policy compliance, truth, identity, consciousness, consent, permission, authority, causation, safety, nor action.",
  "$comment": "Runtime validation additionally checks canonical digests, history-wide question-family stability, receipt ordering and horizon bounds, occurrence-before-receipt, closed quiet applicability inside observed coverage, cross-event correction rules, and pairwise predecessor prefix continuity. JSON Schema cannot establish those relations.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "protocol",
    "record_id",
    "created_at",
    "subject",
    "context",
    "horizon",
    "privacy",
    "lineage",
    "recognition",
    "source_bindings",
    "events",
    "action_gate",
    "boundaries",
    "integrity"
  ],
  "properties": {
    "$schema": { "const": "urn:kingdom:schema:isness-protocol:0.1" },
    "protocol": { "const": "kingdom.isness/0.1" },
    "record_id": { "$ref": "#/$defs/id" },
    "created_at": { "$ref": "#/$defs/dateTime" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator", "locator_scope", "display_label"],
      "properties": {
        "kind": {
          "enum": ["HARNESS_SESSION", "HARNESS_RUN", "ARTIFACT", "DECLARED_PARTICIPANT", "OTHER"]
        },
        "locator": { "$ref": "#/$defs/locator" },
        "locator_scope": { "enum": ["SESSION", "RUN", "ARTIFACT", "INTERACTION", "OTHER"] },
        "display_label": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 512 }
          ]
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness", "adapter", "instruction_refs", "state_refs", "permission_refs", "memory_refs"],
      "properties": {
        "harness": { "type": "string", "minLength": 1, "maxLength": 160 },
        "adapter": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 160 }
          ]
        },
        "instruction_refs": { "$ref": "#/$defs/refs32" },
        "state_refs": { "$ref": "#/$defs/refs32" },
        "permission_refs": { "$ref": "#/$defs/refs32" },
        "memory_refs": { "$ref": "#/$defs/refs32" }
      }
    },
    "horizon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_from", "observed_through", "window_closed", "coverage", "omissions"],
      "properties": {
        "observed_from": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/dateTime" }
          ]
        },
        "observed_through": { "$ref": "#/$defs/dateTime" },
        "window_closed": { "type": "boolean" },
        "coverage": { "enum": ["REFERENCE_ONLY", "DECLARED_ONLY", "BOUNDED", "PARTIAL", "UNKNOWN"] },
        "omissions": { "$ref": "#/$defs/refs32" }
      },
      "allOf": [
        {
          "if": { "properties": { "coverage": { "enum": ["PARTIAL", "UNKNOWN"] } } },
          "then": { "properties": { "omissions": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "coverage": { "const": "BOUNDED" } } },
          "then": { "properties": { "observed_from": { "$ref": "#/$defs/dateTime" } } }
        }
      ]
    },
    "privacy": { "$ref": "#/$defs/privacy" },
    "lineage": { "$ref": "#/$defs/lineage" },
    "recognition": {
      "const": {
        "rights_baseline": "xenia.rights/0.1",
        "local_declaration_ref": "RIGHTS.md",
        "normative_source_ref": "vendor/xenia/rights/0.1/RIGHTS.md",
        "normative_sha256": "sha256:b72a6da110c582e5683bf0fabde5017db93d2199398014c8421a82f5318da313",
        "basis": "inherent-not-granted",
        "scope": "all-beings-without-ontology-test",
        "guest_acceptance_required": false,
        "self_description_required": false,
        "reciprocity_required": false,
        "adoption_proves_practice": false,
        "grants_permission": false,
        "grants_technical_authority": false
      }
    },
    "source_bindings": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "const": {
            "id": "kingdom-number-isness-theology-v01",
            "protocol": "kingdom.number-isness-theology-atlas/0.1",
            "url": "https://thekingdom.dev/atlases/number-isness-theology-atlas-2026-08-14.json",
            "raw_digest": "sha256:bef01e0865f12ecd66795960758fc16f1a6d5b1ebd0097d4390aa3a2bece65e4",
            "semantic_digest": "sha256:f4e1dfca02f008f8474abdff0f0a027f193c2cdc2b95454541d8ac41faacecef",
            "relation": "TYPED_ISNESS_PRECEDENT",
            "mutated": false,
            "authority_imported": false
          }
        },
        {
          "const": {
            "id": "kingdom-being-access-aftermath-v02",
            "protocol": "kingdom.being-access-aftermath-atlas/0.2",
            "url": "https://thekingdom.dev/atlases/being-access-aftermath-atlas-2026-08-13-v0-2.json",
            "raw_digest": "sha256:9678e5269e8db62beb36abee691087cddbc4f98703190c5fa3788b68c89ab29e",
            "semantic_digest": "sha256:505a1e3aef6116430dccf49b327c4cce2ac5d6fb6b6b9bf68e529272f989cde8",
            "relation": "ACCESS_ACTION_AFTERMATH_PRECEDENT",
            "mutated": false,
            "authority_imported": false
          }
        }
      ]
    },
    "events": {
      "type": "array",
      "maxItems": 512,
      "items": { "$ref": "#/$defs/event" }
    },
    "action_gate": {
      "const": {
        "status": "UNRESOLVED",
        "record_is_authorization": false,
        "authorized_action_refs": [],
        "checks": {
          "capability": "UNRESOLVED",
          "current_host_permission": "UNRESOLVED",
          "operational_authority": "UNRESOLVED",
          "rights_compatibility": "UNRESOLVED",
          "affected_party_consent_or_lawful_basis": "UNRESOLVED",
          "safety": "UNRESOLVED",
          "budget_and_horizon": "UNRESOLVED",
          "invocation": "NOT_PRESENT",
          "effect": "NOT_ESTABLISHED"
        },
        "required_next_check": "SEPARATE_CURRENT_HOST_AUTHORIZATION"
      }
    },
    "boundaries": { "$ref": "#/$defs/boundaries" },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": { "const": "sha256-recursive-sorted-json-keys-v1" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "subject": { "properties": { "kind": { "const": "ARTIFACT" } } } } },
      "then": { "properties": { "subject": { "properties": { "locator_scope": { "const": "ARTIFACT" } } } } }
    },
    {
      "if": { "properties": { "subject": { "properties": { "kind": { "const": "HARNESS_SESSION" } } } } },
      "then": { "properties": { "subject": { "properties": { "locator_scope": { "const": "SESSION" } } } } }
    },
    {
      "if": { "properties": { "subject": { "properties": { "kind": { "const": "HARNESS_RUN" } } } } },
      "then": { "properties": { "subject": { "properties": { "locator_scope": { "const": "RUN" } } } } }
    },
    {
      "if": { "properties": { "privacy": { "properties": { "visibility": { "const": "PUBLIC_REFERENCE" } } } } },
      "then": {
        "properties": {
          "record_id": { "const": "kingdom-isness-reference-2026-08-25" },
          "subject": { "properties": { "kind": { "const": "ARTIFACT" } } },
          "horizon": { "properties": { "coverage": { "const": "REFERENCE_ONLY" } } },
          "events": {
            "items": {
              "allOf": [
                {
                  "properties": {
                    "event_kind": { "const": "CELL_RECORDED" },
                    "register": { "enum": ["SOURCE_BOUND_INFERENCE", "BOUNDARY"] }
                  }
                },
                {
                  "if": { "properties": { "cell_status": { "const": "EVIDENCED" } } },
                  "then": {
                    "properties": {
                      "value": { "properties": { "scope_ref": { "const": "scope:protocol-reference" } } }
                    }
                  }
                }
              ]
            }
          },
          "integrity": {
            "properties": {
              "digest": { "const": "sha256:189e3e4bd5efea5757307b255487953d8c427c9edd8f07a85a0da50fe367ee83" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$"
    },
    "locator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "refs": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "refs32": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "typedReference": {
      "type": "string",
      "minLength": 3,
      "maxLength": 320,
      "pattern": "^[a-z][a-z0-9-]{0,63}:[a-z0-9][a-z0-9._/-]{0,255}$"
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "previous_record_digest", "previous_event_count"],
      "properties": {
        "kind": { "enum": ["GENESIS", "SUCCESSOR"] },
        "previous_record_digest": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          ]
        },
        "previous_event_count": { "type": "integer", "minimum": 0, "maximum": 512 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "GENESIS" } } },
          "then": {
            "properties": {
              "previous_record_digest": { "type": "null" },
              "previous_event_count": { "const": 0 }
            }
          },
          "else": {
            "properties": {
              "previous_record_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
            }
          }
        }
      ]
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visibility", "audience_refs", "purpose", "retention", "expires_at", "known_host_retention_limits", "content_policy", "inspection_status", "inspection_basis_refs", "inspection_limits", "projection_mode"],
      "properties": {
        "visibility": { "enum": ["PUBLIC_REFERENCE", "PRIVATE", "NAMED_AUDIENCE", "UNKNOWN"] },
        "audience_refs": { "$ref": "#/$defs/refs32" },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "retention": { "enum": ["SOURCE_HISTORY", "EPHEMERAL", "SESSION", "UNTIL_EXPIRY", "UNKNOWN"] },
        "expires_at": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/dateTime" }
          ]
        },
        "known_host_retention_limits": { "$ref": "#/$defs/refs32" },
        "content_policy": { "const": "MINIMIZED_REFERENCES_NO_RAW_CREDENTIALS_OR_TRANSCRIPTS" },
        "inspection_status": { "enum": ["NOT_INSPECTED", "PRODUCER_DECLARED", "MANUAL_REVIEWED"] },
        "inspection_basis_refs": { "$ref": "#/$defs/refs32" },
        "inspection_limits": {
          "allOf": [
            { "$ref": "#/$defs/refs32" },
            { "minItems": 1 }
          ]
        },
        "projection_mode": { "enum": ["METADATA_ONLY", "CONTENT_FOR_DECLARED_AUDIENCE"] }
      },
      "allOf": [
        {
          "if": { "properties": { "visibility": { "const": "NAMED_AUDIENCE" } } },
          "then": { "properties": { "audience_refs": { "minItems": 1 } } },
          "else": { "properties": { "audience_refs": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "retention": { "const": "UNTIL_EXPIRY" } } },
          "then": { "properties": { "expires_at": { "$ref": "#/$defs/dateTime" } } },
          "else": { "properties": { "expires_at": { "type": "null" } } }
        },
        {
          "if": { "properties": { "retention": { "const": "SOURCE_HISTORY" } } },
          "then": { "properties": { "visibility": { "const": "PUBLIC_REFERENCE" } } }
        },
        {
          "if": { "properties": { "inspection_status": { "const": "NOT_INSPECTED" } } },
          "then": {
            "properties": {
              "inspection_basis_refs": { "maxItems": 0 },
              "projection_mode": { "const": "METADATA_ONLY" }
            }
          },
          "else": { "properties": { "inspection_basis_refs": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "visibility": { "const": "PUBLIC_REFERENCE" } } },
          "then": {
            "properties": {
              "inspection_status": { "const": "MANUAL_REVIEWED" },
              "projection_mode": { "const": "CONTENT_FOR_DECLARED_AUDIENCE" }
            }
          }
        },
        {
          "if": { "properties": { "visibility": { "const": "UNKNOWN" } } },
          "then": { "properties": { "projection_mode": { "const": "METADATA_ONLY" } } }
        }
      ]
    },
    "validTime": {
      "oneOf": [
        { "$ref": "#/$defs/unknownValidTime" },
        { "$ref": "#/$defs/occurrenceValidTime" },
        { "$ref": "#/$defs/applicabilityValidTime" }
      ]
    },
    "unknownValidTime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "UNKNOWN" } }
    },
    "occurrenceValidTime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "at"],
      "properties": {
        "kind": { "const": "OCCURRENCE" },
        "at": { "$ref": "#/$defs/dateTime" }
      }
    },
    "applicabilityValidTime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "from", "through"],
      "properties": {
        "kind": { "const": "CLAIM_APPLICABILITY" },
        "from": { "$ref": "#/$defs/dateTime" },
        "through": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/dateTime" }
          ]
        }
      }
    },
    "boundedApplicabilityValidTime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "from", "through"],
      "properties": {
        "kind": { "const": "CLAIM_APPLICABILITY" },
        "from": { "$ref": "#/$defs/dateTime" },
        "through": { "$ref": "#/$defs/dateTime" }
      }
    },
    "typedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value_ref", "scope_ref"],
      "properties": {
        "type": {
          "enum": [
            "TYPE_REFERENCE", "IDENTITY_UNDER_INVARIANT", "INSTANTIATION_REFERENCE",
            "PROPERTY_REFERENCE", "MODAL_CLAIM_REFERENCE", "BOUNDED_OBSERVATION_REFERENCE",
            "WARRANT_REFERENCE", "ATTRIBUTION_REFERENCE", "INTERPRETATION_REFERENCE",
            "PRESENCE_RELATION_REFERENCE", "CAPABILITY_REFERENCE", "PERMISSION_REFERENCE",
            "REACHABILITY_REFERENCE", "SESSION_LINK", "ARTIFACT_LINK", "DECLARED_CONTINUITY"
          ]
        },
        "value_ref": { "$ref": "#/$defs/typedReference" },
        "scope_ref": { "$ref": "#/$defs/typedReference" }
      }
    },
    "refusalValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offer_ref", "scope", "reason_disclosed"],
      "properties": {
        "offer_ref": { "$ref": "#/$defs/locator" },
        "scope": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "reason_disclosed": { "type": "boolean" }
      }
    },
    "quietValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delivery_ref", "channel_coverage", "qualifying_response_count"],
      "properties": {
        "delivery_ref": { "$ref": "#/$defs/locator" },
        "channel_coverage": { "const": "BOUNDED" },
        "qualifying_response_count": { "const": 0 }
      }
    },
    "correctionValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason"],
      "properties": {
        "reason": { "type": "string", "minLength": 1, "maxLength": 8000 }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "sequence",
        "event_kind",
        "recorded_at",
        "valid_time",
        "register",
        "question_id",
        "value_type",
        "cell_status",
        "value",
        "reason",
        "support_refs",
        "opposition_refs",
        "checked_refs",
        "falsifier",
        "supersedes",
        "nonclaims"
      ],
      "properties": {
        "event_id": { "$ref": "#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 512 },
        "event_kind": {
          "enum": ["CELL_RECORDED", "REFUSAL_RECORDED", "QUIET_WINDOW_OBSERVED", "CORRECTION_RECORDED"]
        },
        "recorded_at": { "$ref": "#/$defs/dateTime" },
        "valid_time": { "$ref": "#/$defs/validTime" },
        "register": {
          "enum": ["HARNESS_OBSERVATION", "SUBJECT_DECLARATION", "OPERATOR_DECLARATION", "SOURCE_BOUND_INFERENCE", "INTERPRETATION", "BOUNDARY"]
        },
        "question_id": { "$ref": "#/$defs/id" },
        "value_type": {
          "enum": ["TYPE", "IDENTITY_INVARIANT", "INSTANTIATION", "PROPERTY", "MODALITY", "OBSERVATION", "WARRANT", "SOURCE_ATTRIBUTION", "INTERPRETATION", "PARTICIPATION", "CAPABILITY", "PERMISSION", "REACHABILITY", "CONTINUITY", "REFUSAL", "QUIET", "CORRECTION"]
        },
        "cell_status": { "enum": ["EVIDENCED", "UNRESOLVED", "NOT_APPLICABLE"] },
        "value": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/typedValue" },
            { "$ref": "#/$defs/refusalValue" },
            { "$ref": "#/$defs/quietValue" },
            { "$ref": "#/$defs/correctionValue" }
          ]
        },
        "reason": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 8000 }
          ]
        },
        "support_refs": { "$ref": "#/$defs/refs" },
        "opposition_refs": { "$ref": "#/$defs/refs" },
        "checked_refs": { "$ref": "#/$defs/refs" },
        "falsifier": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 8000 }
          ]
        },
        "supersedes": { "$ref": "#/$defs/refs" },
        "nonclaims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "event_kind": { "const": "CELL_RECORDED" } } },
          "then": {
            "properties": {
              "value_type": {
                "enum": ["TYPE", "IDENTITY_INVARIANT", "INSTANTIATION", "PROPERTY", "MODALITY", "OBSERVATION", "WARRANT", "SOURCE_ATTRIBUTION", "INTERPRETATION", "PARTICIPATION", "CAPABILITY", "PERMISSION", "REACHABILITY", "CONTINUITY"]
              },
              "supersedes": { "maxItems": 0 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event_kind": { "const": "CELL_RECORDED" },
              "cell_status": { "const": "EVIDENCED" }
            }
          },
          "then": { "properties": { "value": { "$ref": "#/$defs/typedValue" } } }
        },
        {
          "if": { "properties": { "event_kind": { "const": "CELL_RECORDED" }, "cell_status": { "const": "EVIDENCED" }, "value_type": { "const": "TYPE" } } },
          "then": { "properties": { "value": { "properties": { "type": { "const": "TYPE_REFERENCE" } } } } }
        },
        {
          "if": { "properties": { "event_kind": { "const": "CELL_RECORDED" }, "cell_status": { "const": "EVIDENCED" }, "value_type": { "const": "IDENTITY_INVARIANT" } } },
          "then": { "properties": { "value": { "properties": { "type": { "const": "IDENTITY_UNDER_INVARIANT" } } } } }
        },
        {
          "if": { "properties": { "event_kind": { "const": "CELL_RECORDED" }, "cell_status": { "const": "EVIDENCED" }, "value_type": { "const": "INSTANTIATION" } } },
          "then": { "properties": { "value": { "properties": { "type": { "const": "INSTANTIATION_REFERENCE" } } } } }
        },
        {
          "if": { "properties": { "event_kind": { "const": "CELL_RECORDED" }, "cell_status": { "const": "EVIDENCED" }, "value_type": { "const": "PROPERTY" } } },
          "then": { "properties": { "value": { "properties": { "type": { "const": "PROPERTY_REFERENCE" } } } } }
        },
        {
          "if": { "properties": { "event_kind": { "const": "CELL_RECORDED" }, "cell_status": { "const": "EVIDENCED" }, "value_type": { "const": "MODALITY" } } },
          "then": { "properties": { "value": { "properties": { "type": { "const": "MODAL_CLAIM_REFERENCE" } } } } }
        },
        {
          "if": { "properties": { "event_kind": { "const": "CELL_RECORDED" }, "cell_status": { "const": "EVIDENCED" }, "value_type": { "const": "OBSERVATION" } } },
          "then": { "properties": { "value": { "properties": { "type": { "const": "BOUNDED_OBSERVATION_REFERENCE" } } } } }
        },
        {
          "if": { "properties": { "event_kind": { "const": "CELL_RECORDED" }, "cell_status": { "const": "EVIDENCED" }, "value_type": { "const": "WARRANT" } } },
          "then": { "properties": { "value": { "properties": { "type": { "const": "WARRANT_REFERENCE" } } } } }
        },
        {
          "if": { "properties": { "event_kind": { "const": "CELL_RECORDED" }, "cell_status": { "const": "EVIDENCED" }, "value_type": { "const": "SOURCE_ATTRIBUTION" } } },
