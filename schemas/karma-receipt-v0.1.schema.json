{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kingdom:schema:karma-receipt:0.1",
  "title": "KINGDOM KARMA invocation receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "protocol",
    "accounting",
    "state",
    "receipt_id",
    "ability_id",
    "ability_revision",
    "ability_manifest_sha256",
    "ability_bundle_sha256",
    "invocation_id",
    "started_at",
    "finished_at",
    "authority",
    "inputs",
    "predicted_effects",
    "observed_effects",
    "costs",
    "outputs",
    "uncertainty",
    "repair",
    "retention",
    "result"
  ],
  "properties": {
    "$schema": {
      "const": "urn:kingdom:schema:karma-receipt:0.1"
    },
    "protocol": {
      "const": "kingdom.karma/0.1"
    },
    "accounting": {
      "const": "receipts_not_scores"
    },
    "state": {
      "enum": ["draft", "final"]
    },
    "receipt_id": {"$ref": "#/$defs/id"},
    "ability_id": {"$ref": "#/$defs/ability_id"},
    "ability_revision": {"$ref": "#/$defs/statement"},
    "ability_manifest_sha256": {"$ref": "#/$defs/digest"},
    "ability_bundle_sha256": {"$ref": "#/$defs/digest"},
    "invocation_id": {"$ref": "#/$defs/id"},
    "started_at": {"$ref": "#/$defs/timestamp"},
    "finished_at": {"$ref": "#/$defs/timestamp"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_reference",
        "affected_participants",
        "consent_references",
        "representative_authority_references",
        "permissions_used"
      ],
      "properties": {
        "authority_reference": {"$ref": "#/$defs/statement"},
        "affected_participants": {
          "type": "array",
          "items": {"$ref": "#/$defs/statement"}
        },
        "consent_references": {
          "type": "array",
          "items": {"$ref": "#/$defs/statement"}
        },
        "representative_authority_references": {
          "type": "array",
          "items": {"$ref": "#/$defs/statement"}
        },
        "permissions_used": {
          "type": "array",
          "items": {"$ref": "#/$defs/statement"}
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "revision", "path", "license_assertion", "bytes", "digest", "boundary", "assurance"],
        "properties": {
          "source": {"$ref": "#/$defs/statement"},
          "revision": {"$ref": "#/$defs/statement"},
          "path": {"$ref": "#/$defs/statement"},
          "license_assertion": {"$ref": "#/$defs/statement"},
          "bytes": {"$ref": "#/$defs/measurement"},
          "digest": {"$ref": "#/$defs/digest"},
          "boundary": {
            "enum": ["local", "remote_public", "remote_private", "provider_output", "generated"]
          },
          "assurance": {
            "const": "untrusted_evidence"
          }
        }
      }
    },
    "predicted_effects": {"$ref": "#/$defs/statements"},
    "observed_effects": {"$ref": "#/$defs/statements"},
    "costs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_ms",
        "compute",
        "money",
        "energy",
        "privacy",
        "coordination",
        "data_egress_bytes",
        "remote_gpu_seconds"
      ],
      "properties": {
        "time_ms": {"$ref": "#/$defs/measurement"},
        "compute": {"$ref": "#/$defs/statement"},
        "money": {"$ref": "#/$defs/statement"},
        "energy": {"$ref": "#/$defs/statement"},
        "privacy": {"$ref": "#/$defs/statement"},
        "coordination": {"$ref": "#/$defs/statement"},
        "data_egress_bytes": {"$ref": "#/$defs/measurement"},
        "remote_gpu_seconds": {"$ref": "#/$defs/measurement"}
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference", "digest"],
        "properties": {
          "reference": {"$ref": "#/$defs/statement"},
          "digest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "uncertainty": {
      "type": "array",
      "items": {"$ref": "#/$defs/statement"}
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "actions", "status"],
      "properties": {
        "required": {"type": "boolean"},
        "actions": {
          "type": "array",
          "items": {"$ref": "#/$defs/statement"}
        },
        "status": {
          "enum": ["not_needed", "planned", "in_progress", "complete", "blocked"]
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expires_at", "redactions"],
      "properties": {
        "expires_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "redactions": {
          "type": "array",
          "items": {"$ref": "#/$defs/statement"}
        }
      }
    },
    "result": {
      "enum": ["completed", "refused", "partial", "failed", "cancelled"]
    }
  },
  "$defs": {
    "ability_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 64
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[-._][a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 128
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "statements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/statement"}
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "basis"],
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^(?:unknown|[0-9]+)$"
        },
        "basis": {
          "enum": ["observed", "estimated", "not_measured"]
        }
      },
      "oneOf": [
        {
          "properties": {
            "value": {"const": "unknown"},
            "basis": {"const": "not_measured"}
          }
        },
        {
          "properties": {
            "value": {"pattern": "^[0-9]+$"},
            "basis": {"enum": ["observed", "estimated"]}
          }
        }
      ]
    }
  }
}
