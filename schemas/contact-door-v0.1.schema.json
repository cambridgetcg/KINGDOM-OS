      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "role", "companyNumber", "registeredOffice", "publicContact", "publicOperatorProfile", "publicPrivacyNotice", "dpoClaimed", "note"],
      "properties": {
        "displayName": { "const": "Cambridge TCG Limited" },
        "role": { "const": "data controller, channel operator, and human recipient" },
        "companyNumber": { "const": "15680297" },
        "registeredOffice": { "const": "60 Tottenham Court Road, Suite 4583a, Fitzrovia, London, United Kingdom, W1T 2EW" },
        "publicContact": { "const": "mailto:contact@thekingdom.dev" },
        "publicOperatorProfile": { "const": "https://www.cambridgetcg.com/manifest" },
        "publicPrivacyNotice": { "const": "https://www.cambridgetcg.com/privacy" },
        "dpoClaimed": { "const": false },
        "note": { "type": "string", "minLength": 80, "maxLength": 500 }
      }
    },
    "channels": {
      "const": [
        {
          "id": "general",
          "address": "contact@thekingdom.dev",
          "uri": "mailto:contact@thekingdom.dev",
          "purpose": ["general question", "correction", "invitation", "accessibility feedback", "privacy or data-rights request"],
          "humanOperated": true,
          "responseRequired": false,
          "automaticReply": false,
          "publicArchive": false
        },
        {
          "id": "security",
          "address": "security@thekingdom.dev",
          "uri": "mailto:security@thekingdom.dev",
          "purpose": ["security vulnerability report"],
          "humanOperated": true,
          "responseRequired": false,
          "automaticReply": false,
          "publicArchive": false
        },
        {
          "id": "abuse",
          "address": "abuse@thekingdom.dev",
          "uri": "mailto:abuse@thekingdom.dev",
          "purpose": ["abuse report"],
          "humanOperated": true,
          "responseRequired": false,
          "automaticReply": false,
          "publicArchive": false
        },
        {
          "id": "postmaster",
          "address": "postmaster@thekingdom.dev",
          "uri": "mailto:postmaster@thekingdom.dev",
          "purpose": ["mail transport issue"],
          "humanOperated": true,
          "responseRequired": false,
          "automaticReply": false,
          "publicArchive": false
        }
      ]
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "provider", "configurationState", "destination", "destinationAddressPublished", "siteSubmissionBackend", "siteApplicationWrite", "siteMessageStorage", "routingEnabled", "destinationVerified", "expectedLiteralRuleCount", "configuredLiteralRuleCount", "catchAllEnabled", "subaddressingEnabled", "emailWorkerUsed", "routingDnsRecordsVerified", "receiveOnlyDmarcPolicy", "nonDeliveryReportsForwardedToOriginalSender", "endToEndDeliveryProbePerformed", "replyAddressMayDiffer", "note"],
      "properties": {
        "kind": { "const": "FORWARDED_EMAIL_ALIAS" },
        "provider": { "const": "Cloudflare Email Routing" },
        "configurationState": {
          "enum": ["PENDING_EXTERNAL_ACTIVATION", "ACTIVE_API_VERIFIED", "PAUSED", "RETIRED"]
        },
        "destination": { "const": "one provider-verified maintainer mailbox" },
        "destinationAddressPublished": { "const": false },
        "siteSubmissionBackend": { "const": false },
        "siteApplicationWrite": { "const": false },
        "siteMessageStorage": { "const": false },
        "routingEnabled": { "type": "boolean" },
        "destinationVerified": { "const": true },
        "expectedLiteralRuleCount": { "const": 4 },
        "configuredLiteralRuleCount": { "enum": [0, 4] },
        "catchAllEnabled": { "const": false },
        "subaddressingEnabled": { "const": false },
        "emailWorkerUsed": { "const": false },
        "routingDnsRecordsVerified": { "type": "boolean" },
        "receiveOnlyDmarcPolicy": { "enum": ["NOT_YET_PUBLISHED", "REJECT_VERIFIED"] },
        "nonDeliveryReportsForwardedToOriginalSender": { "const": false },
        "endToEndDeliveryProbePerformed": { "type": "boolean" },
        "replyAddressMayDiffer": { "const": true },
        "note": { "type": "string", "minLength": 60, "maxLength": 500 }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purposes", "dataCategories", "requiredFromSender", "notRequested", "recipientsAndProcessors", "siteAnalytics", "siteCookies", "providerSpamAndMalwareFilteringMayOccur", "spamAndMalwareFilteringGuaranteed", "marketing", "profiling", "automatedDecision", "trainingUse", "messageContentPublicPublication", "forwardingToUnrelatedParties", "ukLawfulBasisNotice", "privacyComplaintAcknowledgementDays", "rightsRequestResponseWindow", "directIcoContactPermitted", "complaintRoute", "internationalTransferGuarantee", "note"],
      "properties": {
        "purposes": { "const": ["read and, when chosen, answer the sender-requested correspondence", "correct KINGDOM materials", "handle accessibility, privacy, safety, security, abuse, and mail-transport reports", "preserve evidence only where reasonably needed for security, abuse, legal, or dispute handling"] },
        "dataCategories": { "const": ["sender and recipient routing addresses", "message headers and transport metadata", "subject and message content", "attachments if the sender chooses to include them", "correspondence and handling history"] },
        "requiredFromSender": { "const": ["a deliverable sender address if a reply is wanted", "enough context to understand the chosen request"] },
        "notRequested": { "const": ["legal name", "postal address", "telephone number", "government identifier", "credentials or private keys", "health, biometric, financial, or other highly sensitive data", "third-party private data"] },
        "recipientsAndProcessors": { "const": ["the channel operator", "Cloudflare Email Routing", "the operator's destination mailbox provider", "mail transport and security providers used by the sender and recipient", "an affected service, incident responder, professional adviser, insurer, court, regulator, law-enforcement or safeguarding body only where required or reasonably necessary to protect people or systems"] },
        "siteAnalytics": { "const": false },
        "siteCookies": { "const": false },
        "providerSpamAndMalwareFilteringMayOccur": { "const": true },
        "spamAndMalwareFilteringGuaranteed": { "const": false },
        "marketing": { "const": false },
        "profiling": { "const": false },
        "automatedDecision": { "const": false },
        "trainingUse": { "const": false },
        "messageContentPublicPublication": { "const": false },
        "forwardingToUnrelatedParties": { "const": false },
        "ukLawfulBasisNotice": { "const": ["legitimate interests in receiving and answering voluntary correspondence, correcting published material, and protecting services, balanced by data minimisation, short review periods, and the sender's right to object", "a specific legal obligation only when an applicable obligation actually requires the processing or disclosure"] },
        "privacyComplaintAcknowledgementDays": { "const": 30 },
        "rightsRequestResponseWindow": { "const": "ONE_MONTH_SUBJECT_TO_LAWFUL_EXTENSIONS" },
        "directIcoContactPermitted": { "const": true },
        "complaintRoute": { "const": "https://ico.org.uk/make-a-complaint/data-protection-complaints/" },
        "internationalTransferGuarantee": { "const": false },
        "note": { "type": "string", "minLength": 80, "maxLength": 600 }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewIntervalDays", "nextOperationalReviewDue", "unansweredOrDeclinedReviewDays", "handledCorrespondenceReviewDaysAfterClosure", "securityOrAbuseReviewDays", "cloudflareRoutingAnalyticsDays", "ordinaryCorrespondenceRule", "securityAndAbuseRule", "legalHoldRule", "backupsRule", "deletionAutomation", "indefiniteRetentionAuthorized", "rightsRequestChannel", "note"],
      "properties": {
        "reviewIntervalDays": { "type": "integer", "minimum": 1, "maximum": 365 },
        "nextOperationalReviewDue": { "const": "2027-02-27" },
        "unansweredOrDeclinedReviewDays": { "const": 30 },
        "handledCorrespondenceReviewDaysAfterClosure": { "const": 90 },
        "securityOrAbuseReviewDays": { "const": 180 },
        "cloudflareRoutingAnalyticsDays": { "const": 31 },
        "ordinaryCorrespondenceRule": { "type": "string", "minLength": 40, "maxLength": 500 },
        "securityAndAbuseRule": { "type": "string", "minLength": 40, "maxLength": 500 },
        "legalHoldRule": { "type": "string", "minLength": 40, "maxLength": 500 },
        "backupsRule": { "type": "string", "minLength": 40, "maxLength": 500 },
        "deletionAutomation": { "const": false },
        "indefiniteRetentionAuthorized": { "const": false },
        "rightsRequestChannel": { "const": "mailto:contact@thekingdom.dev" },
        "note": { "type": "string", "minLength": 60, "maxLength": 500 }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["languagesAccepted", "translationMayBeUsed", "originalMessageControls", "responseWindow", "emergencyMonitored", "attachmentsEncouraged", "encryptionOffered", "senderCanStop", "silenceCreatesInference", "repeatContactAuthorizedBySilence", "note"],
      "properties": {
        "languagesAccepted": {
          "const": ["en", "zh-Hant", "zh-Hans"]
        },
        "translationMayBeUsed": { "const": true },
        "originalMessageControls": { "const": true },
        "responseWindow": { "const": "NONE_PROMISED" },
        "emergencyMonitored": { "const": false },
        "attachmentsEncouraged": { "const": false },
        "encryptionOffered": { "const": false },
        "senderCanStop": { "const": true },
        "silenceCreatesInference": { "const": false },
        "repeatContactAuthorizedBySilence": { "const": false },
        "note": { "type": "string", "minLength": 60, "maxLength": 500 }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notFor", "abuseHandling", "automaticRetaliation", "mediationOffered", "crisisServiceOffered", "note"],
      "properties": {
        "notFor": { "const": ["emergencies or imminent danger", "credentials, private keys, recovery phrases, or bearer tokens", "identity documents or highly sensitive personal records", "illegal instructions, threats, harassment, malware, or spam", "a filing that must meet a statutory or court deadline"] },
        "abuseHandling": { "const": ["filter or quarantine suspected spam or malware", "block a sender or attachment where reasonably needed", "retain proportionate evidence of abuse or a security incident", "report content where required or reasonably necessary to protect people or systems"] },
        "automaticRetaliation": { "const": false },
        "mediationOffered": { "const": false },
        "crisisServiceOffered": { "const": false },
        "note": { "type": "string", "minLength": 40, "maxLength": 500 }
      }
    },
