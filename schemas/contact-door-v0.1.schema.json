        "description": { "type": "string", "minLength": 80, "maxLength": 600 }
      }
    },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "currentRecord", "canonicalRecord", "schema", "guide", "securityTxt", "boundaryAsset", "vCard"],
