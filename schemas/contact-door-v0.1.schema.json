        "page": { "const": "https://thekingdom.dev/contact/" },
        "currentRecord": { "const": "https://thekingdom.dev/contact.json" },
        "canonicalRecord": { "const": "https://thekingdom.dev/contacts/contact-door-2026-08-31.json" },
        "schema": { "const": "https://thekingdom.dev/schemas/contact-door/0.1.json" },
        "guide": { "const": "https://thekingdom.dev/CONTACT-DOOR-v0.1.md" },
        "securityTxt": { "const": "https://thekingdom.dev/.well-known/security.txt" },
        "boundaryAsset": { "const": "https://thekingdom.dev/contact/assets/contact-boundary-v0.1.svg" },
        "vCard": { "const": "https://thekingdom.dev/contact/contact-v0.1.vcf" }
      }
    },
