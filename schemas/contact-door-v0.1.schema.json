      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "inboundMayBeLogged", "messageContentLoggedByDefault", "minimalEventMetadataOnly", "ledgerCreatesIdentityOrAuthority", "note"],
      "properties": {
        "owner": { "const": "CONTACT-LEDGER.md" },
        "inboundMayBeLogged": { "const": true },
        "messageContentLoggedByDefault": { "const": false },
        "minimalEventMetadataOnly": { "const": true },
        "ledgerCreatesIdentityOrAuthority": { "const": false },
        "note": { "type": "string", "minLength": 60, "maxLength": 500 }
      }
    },
