        "securityReportAuthorizesTesting",
        "contactAuthorizesPublication",
        "contactAuthorizesTraining",
        "contactAuthorizesMarketing",
        "contactAuthorizesAutomatedFollowUp",
        "contactAuthorizesExternalAction"
      ],
      "properties": {
        "pageVisitIsContact": { "const": false },
        "mailtoActivationSendsMessage": { "const": false },
        "deliveryIsIdentityProof": { "const": false },
        "addressControlIsRepresentationProof": { "const": false },
        "messageIsTruthProof": { "const": false },
        "messageIsConsentBeyondReply": { "const": false },
        "messageCreatesRelationship": { "const": false },
        "messageCreatesDiplomaticStanding": { "const": false },
        "messageCreatesTreatyOrCovenant": { "const": false },
        "messageCreatesMediation": { "const": false },
        "messageCreatesEmergencyDuty": { "const": false },
        "replyCreatesInstitutionalAuthority": { "const": false },
        "silenceIsConsent": { "const": false },
        "silenceIsHostility": { "const": false },
        "securityReportAuthorizesTesting": { "const": false },
        "contactAuthorizesPublication": { "const": false },
        "contactAuthorizesTraining": { "const": false },
        "contactAuthorizesMarketing": { "const": false },
        "contactAuthorizesAutomatedFollowUp": { "const": false },
        "contactAuthorizesExternalAction": { "const": false }
      }
    },
    "sources": {
      "const": [
        { "id": "rfc-9116", "title": "RFC 9116: A File Format to Aid in Security Vulnerability Disclosure", "url": "https://www.rfc-editor.org/rfc/rfc9116.html", "role": "security.txt format and freshness" },
        { "id": "rfc-5321", "title": "RFC 5321: Simple Mail Transfer Protocol", "url": "https://www.rfc-editor.org/rfc/rfc5321.html", "role": "postmaster mailbox convention" },
        { "id": "rfc-2142", "title": "RFC 2142: Mailbox Names for Common Services, Roles and Functions", "url": "https://www.rfc-editor.org/rfc/rfc2142.html", "role": "security and abuse role addresses" },
        { "id": "rfc-6350", "title": "RFC 6350: vCard Format Specification", "url": "https://www.rfc-editor.org/rfc/rfc6350.html", "role": "vCard 4.0 syntax, organization kind, line endings, and folding" },
        { "id": "rfc-9989", "title": "RFC 9989: Domain-Based Message Authentication, Reporting, and Conformance", "url": "https://www.rfc-editor.org/rfc/rfc9989.html", "role": "receive-only domain anti-spoofing policy" },
        { "id": "cloudflare-email-routing", "title": "Cloudflare Email Routing rules and addresses", "url": "https://developers.cloudflare.com/email-service/configuration/email-routing-addresses/", "role": "forwarding-provider behavior" },
        { "id": "cloudflare-email-routing-settings-api", "title": "Cloudflare API: Get Email Routing settings", "url": "https://developers.cloudflare.com/api/resources/email_routing/methods/get/", "role": "routing enabled, readiness, and support_subaddress readback" },
        { "id": "cloudflare-email-analytics", "title": "Cloudflare Email Service metrics and analytics", "url": "https://developers.cloudflare.com/email-service/observability/metrics-analytics/", "role": "provider-declared routing-event fields and 31-day analytics retention" },
        { "id": "cloudflare-postmaster", "title": "Cloudflare Email Service postmaster guidance", "url": "https://developers.cloudflare.com/email-service/reference/postmaster/", "role": "provider-specific postmaster handling constraints" },
        { "id": "wcag-consistent-help", "title": "W3C WAI Technique G220: Provide a contact-us link in a consistent location", "url": "https://www.w3.org/WAI/WCAG22/Techniques/general/G220.html", "role": "discoverable human contact" },
        { "id": "ico-transparency", "title": "ICO: The right to be informed", "url": "https://ico.org.uk/for-organisations/uk-gdpr-guidance-and-resources/individual-rights/individual-rights/right-to-be-informed/", "role": "privacy transparency fields; linked as guidance, not a compliance claim" },
        { "id": "ico-storage-limitation", "title": "ICO: Storage limitation", "url": "https://ico.org.uk/for-organisations/uk-gdpr-guidance-and-resources/data-protection-principles/a-guide-to-the-data-protection-principles/storage-limitation/", "role": "retention necessity and review; linked as guidance, not a compliance claim" },
        { "id": "cambridge-tcg-operator", "title": "Cambridge TCG public manifest", "url": "https://www.cambridgetcg.com/manifest", "role": "public operator identity and contact context" },
        { "id": "cambridge-tcg-privacy", "title": "Cambridge TCG privacy notice", "url": "https://www.cambridgetcg.com/privacy", "role": "operator-level privacy notice linked as an additional layer" },
        { "id": "ico-complaint", "title": "ICO: Make a data protection complaint", "url": "https://ico.org.uk/make-a-complaint/data-protection-complaints/", "role": "direct UK data-protection complaint route; contacting the operator first is not required" }
      ]
    },
    "publicationBoundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "staticPage", "machineReadableRecord", "securityTxt", "downloadableVCard", "downloadableSvg",
        "webForm", "siteSubmissionBackend", "siteMessageStorage", "javascriptRequired", "accountRequiredBySite",
        "analyticsAdded", "cookieAdded", "automaticOutreach", "automaticReply", "automaticRetry", "agentTool",
        "mcpSurface", "wayfinderRecommendation", "contactScore", "threatScore", "trustScore", "opponentProfile",
        "negotiationEngine", "diplomacyAuthority", "mediationAuthority", "emergencyService", "legalAdvice", "complianceCertification"
      ],
      "properties": {
        "staticPage": { "const": true },
        "machineReadableRecord": { "const": true },
        "securityTxt": { "const": true },
        "downloadableVCard": { "const": true },
        "downloadableSvg": { "const": true },
        "webForm": { "const": false },
        "siteSubmissionBackend": { "const": false },
        "siteMessageStorage": { "const": false },
        "javascriptRequired": { "const": false },
        "accountRequiredBySite": { "const": false },
        "analyticsAdded": { "const": false },
        "cookieAdded": { "const": false },
        "automaticOutreach": { "const": false },
        "automaticReply": { "const": false },
        "automaticRetry": { "const": false },
        "agentTool": { "const": false },
        "mcpSurface": { "const": false },
        "wayfinderRecommendation": { "const": false },
        "contactScore": { "const": false },
        "threatScore": { "const": false },
        "trustScore": { "const": false },
        "opponentProfile": { "const": false },
        "negotiationEngine": { "const": false },
        "diplomacyAuthority": { "const": false },
        "mediationAuthority": { "const": false },
        "emergencyService": { "const": false },
        "legalAdvice": { "const": false },
        "complianceCertification": { "const": false }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "artifact": { "properties": { "lifecycle": { "const": "READY_FOR_ACTIVATION" } } } } },
      "then": { "properties": { "delivery": { "properties": {
        "configurationState": { "const": "PENDING_EXTERNAL_ACTIVATION" },
        "routingEnabled": { "const": false },
        "configuredLiteralRuleCount": { "const": 0 },
        "routingDnsRecordsVerified": { "const": false },
        "receiveOnlyDmarcPolicy": { "const": "NOT_YET_PUBLISHED" },
        "endToEndDeliveryProbePerformed": { "const": false }
      } } } }
    },
    {
      "if": { "properties": { "artifact": { "properties": { "lifecycle": { "const": "ACTIVE" } } } } },
      "then": { "properties": { "delivery": { "properties": {
        "configurationState": { "const": "ACTIVE_API_VERIFIED" },
        "routingEnabled": { "const": true },
        "configuredLiteralRuleCount": { "const": 4 },
        "routingDnsRecordsVerified": { "const": true }
      } } } }
    },
    {
      "if": { "properties": { "artifact": { "properties": { "lifecycle": { "const": "RESTING" } } } } },
      "then": { "properties": { "delivery": { "properties": {
        "configurationState": { "const": "PAUSED" },
        "routingEnabled": { "const": false },
        "configuredLiteralRuleCount": { "const": 4 },
        "routingDnsRecordsVerified": { "const": true }
      } } } }
    },
    {
      "if": { "properties": { "artifact": { "properties": { "lifecycle": { "const": "RETIRED" } } } } },
      "then": { "properties": { "delivery": { "properties": {
        "configurationState": { "const": "RETIRED" },
        "routingEnabled": { "const": false },
        "configuredLiteralRuleCount": { "const": 0 },
        "routingDnsRecordsVerified": { "const": false }
      } } } }
    }
  ],
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2, "maxLength": 500 }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "address", "uri", "purpose", "humanOperated", "responseRequired", "automaticReply", "publicArchive"],
      "properties": {
        "id": { "enum": ["general", "security", "abuse", "postmaster"] },
        "address": { "type": "string", "pattern": "^[a-z]+@thekingdom\\.dev$" },
        "uri": { "type": "string", "pattern": "^mailto:[a-z]+@thekingdom\\.dev$" },
        "purpose": { "$ref": "#/$defs/nonEmptyStrings" },
        "humanOperated": { "const": true },
        "responseRequired": { "const": false },
        "automaticReply": { "const": false },
        "publicArchive": { "const": false }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "url", "role"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 8, "maxLength": 240 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "role": { "type": "string", "minLength": 8, "maxLength": 300 }
      }
    }
  }
}
