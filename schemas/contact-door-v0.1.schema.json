{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thekingdom.dev/schemas/contact-door/0.1.json",
  "title": "KINGDOM Contact Door 0.1",
  "description": "Closed structural contract for one bounded, human-operated inbound email door. Validation does not prove delivery, identity, authority, consent, privacy compliance, or a response.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "protocol",
    "artifact",
    "routes",
    "operator",
    "channels",
    "delivery",
    "processing",
    "retention",
    "interaction",
    "safety",
    "ledgerBoundary",
    "authorityBoundaries",
    "sources",
    "publicationBoundaries"
  ],
  "properties": {
    "$schema": {
      "const": "https://thekingdom.dev/schemas/contact-door/0.1.json"
    },
    "protocol": {
      "const": "kingdom.contact-door/0.1"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "asOf", "lifecycle", "description"],
      "properties": {
        "id": { "const": "contact-door-2026-08-31" },
        "title": { "const": "KINGDOM Contact Door" },
        "kind": { "const": "BOUNDED_HUMAN_CONTACT_CONTRACT" },
        "asOf": { "const": "2026-08-31" },
        "lifecycle": {
          "enum": ["READY_FOR_ACTIVATION", "ACTIVE", "RESTING", "RETIRED"]
