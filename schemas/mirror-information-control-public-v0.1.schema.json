{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kingdom:schema:mirror-information-control-public:0.1",
  "$comment": "Closed schema for one immutable static source-law publication. Validation cannot recompute its semantic digest, classify a credential, establish a registry match, prove noninterference or a no-oracle property, grant authority, deploy a Mirror, or enforce a control. The public artifact accepts no credential or envelope input.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "protocol",
    "publication_id",
    "title",
    "compiled_on",
    "evidence_through",
    "artifact_kind",
    "source_binding",
    "citizen_law",
    "rooms",
    "cycle",
    "laws",
    "illustrative_paths",
    "protected_signal_rule",
    "no_oracle_rule",
    "public_surface",
    "private_material_included",
    "response_boundary",
    "sources",
    "rights",
    "karma",
    "negative_effects",
    "presentation",
    "integrity"
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2400,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)*$"
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "meaning", "implemented_by_publication", "operational_data_included", "authority_effect"],
      "properties": {
        "id": { "enum": ["CROWN", "COURT", "MIRROR"] },
        "meaning": { "$ref": "#/$defs/text" },
        "implemented_by_publication": { "const": false },
        "operational_data_included": { "const": false },
        "authority_effect": { "const": "NONE" }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "meaning", "performed_by_publication"],
      "properties": {
        "id": { "enum": ["mark", "isolate", "restrict", "resolve", "observe", "respond"] },
        "label": { "$ref": "#/$defs/text" },
        "meaning": { "$ref": "#/$defs/text" },
        "performed_by_publication": { "const": false }
      }
    },
    "law": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "statement", "runtime_enforced", "authority_effect"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "kind": { "enum": ["DESIGN_RULE", "DESIGN_TARGET_NOT_PROOF", "CATEGORICAL_BOUNDARY"] },
        "statement": { "$ref": "#/$defs/text" },
        "runtime_enforced": { "const": false },
        "authority_effect": { "const": "NONE" }
      }
    },
    "pathStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "effect"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "state": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[A-Z][A-Z_]+$" },
        "effect": { "const": "NONE" }
      }
    },
    "illustrativePath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "observed", "evidence_effect", "actor_inference", "steps"],
      "properties": {
        "id": { "enum": ["prompt-injection-path", "credential-candidate-path"] },
        "kind": { "const": "SYNTHETIC_DESIGN_PATH" },
        "observed": { "const": false },
        "evidence_effect": { "const": "NONE" },
        "actor_inference": { "const": false },
        "steps": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/pathStep" }
        }
      }
    }
  },
  "properties": {
    "$schema": { "const": "urn:kingdom:schema:mirror-information-control-public:0.1" },
    "protocol": { "const": "kingdom.mirror-information-control-public/0.1" },
