        { "allOf": [{ "$ref": "#/$defs/law" }, { "properties": { "id": { "const": "data-not-command" } } }] },
        { "allOf": [{ "$ref": "#/$defs/law" }, { "properties": { "id": { "const": "monotone-influence" } } }] },
