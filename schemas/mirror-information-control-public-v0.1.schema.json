            { "const": { "path": "skills/guard-information-flow/agents/openai.yaml", "sha256": "sha256:9afab3ed30fb9dfc67c0bbca150d0449dc858f96860dbb7bbcf1592e38a763e9", "public_role": "OPT_IN_METADATA" } },
