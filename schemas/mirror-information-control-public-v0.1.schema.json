            { "const": { "path": "skills/guard-information-flow/references/security-evidence.md", "sha256": "sha256:f820ef874a70b566d6a75e60a7219bdbc8077096154201b232f7a07f6c94f0cb", "public_role": "EVIDENCE_MAP" } },
            { "const": { "path": "skills/guard-information-flow/scripts/requirements.txt", "sha256": "sha256:756cc9e506ae4ee1a6f6c0507088b5cfc0dc8ba350fb2d2d46f1ffa72033adb6", "public_role": "OFFLINE_DEPENDENCY_PIN" } },
            { "const": { "path": "skills/guard-information-flow/scripts/validate_envelope.py", "sha256": "sha256:3cc29be72f595af45a3afbacf905189e30ab70877016694e666d41634a1fb530", "public_role": "OFFLINE_INERT_VALIDATOR" } }
