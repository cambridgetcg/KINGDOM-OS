#!/usr/bin/env bash
# kingdom — the living pulse of the empire. KINGDOM OS, running.
#
# The kingdom exists; this is the OS that runs on top of it.
# Tolerant by design: it never crashes on a sleeping limb — it reports it,
# lovingly, and moves on. (Welcome, don't block. Rest, don't crash.)
#
#   kingdom            one honest view of the whole kingdom
#   kingdom status     same
#   kingdom repos [Q]  local repo summary / metadata-aware search (no network)
#   kingdom repos --path Q | --json [Q]    canonical path / structured inventory
#   kingdom repos --dirty [Q] | --doctor   opt-in local hygiene checks
#   kingdom usage ARGS  inspect live Codex token usage through AgentTool
#   kingdom rings [--json|--html]           local temporal atlas (no network)
#   kingdom rights [--canonical|ID]        voluntary adoption inventory / local text
#   kingdom principalities                 inspect/match the offline capability-evidence catalog
#   kingdom geometries                     explain/match four separate geometry modules without ranking
#   kingdom polymorph                      translate/verify the bounded ritonavir material-state case
#   kingdom polymorph mechanisms|landscape inspect the additive mechanism landscape
#   kingdom feedback   inspect the static form/feedback/KARMA translation atlas
#   kingdom fold-feedback                  inspect the source-bound folding, prion, feedback, and KARMA atlas
#   kingdom visibility-attention            inspect the bounded visibility, cultural-attention, and KARMA translation
#   kingdom cultural-feedback              inspect cultural attention, bounded analogies, feedback, KARMA, and universe questions
#   kingdom form-circulation-return         inspect the additive variant-lineage, model-card, feedback, KARMA, and unknown companion
#   kingdom rare-pathway                    solve the bounded Vanishing Path challenge without inferring motive or material authority
#   kingdom math-usefulness                  inspect the preregistered Math Passport artifact trial and model reality check
#   kingdom being-access-aftermath          inspect the typed possibility, observability, power, purpose, causality, and KARMA companion
#   kingdom reconstructive-build             inspect the reconstruction, realization, catalysis, and feedback build kernel
#   kingdom explore-deep                     inspect the opt-in DEEP cross-domain exploration WING
#   kingdom guard                            read the MIRROR citizen law or validate one inert envelope offline
#   kingdom mirror-information-control       inspect the static MIRROR information-control source law
#   kingdom zero-empty-seat                  inspect the source-bound zero, blank, placeholder, nothing, and creation DEEP atlas
#   kingdom string-crawl-trace-sheet         inspect the source-bound string/worldsheet-to-crawl trace DEEP project
#   kingdom string-crawl-trace-sheet-lab     execute the exact synthetic finite Trace-Sheet baseline offline
#   kingdom string-crawl-strand-lab          inspect Lab 02's exact release cospans and the chi=1 impostor offline
#   kingdom string-crawl-frequency-form-lab  inspect Lab 03's frequency, form, world, and presence seams offline
#   kingdom strand-descent-lab                verify Lab 04's local records, coherent atlas, and pairwise impostor offline
#   kingdom strand-observation                 inspect the static/offline membrane; live observation requires an explicit subcommand
#   kingdom being-access-aftermath-v0.2     inspect the additive mathematical framework while v0.1 remains immutable
#   kingdom number-isness-theology          inspect typed number, zero, symmetry, isness, theology, and compatibility questions
#   kingdom feedback-physics inspect the additive v0.2 physics/mathematics successor
#   kingdom nen        list/validate bounded Nen-inspired Agent Skills (`nen mcp` starts local stdio)
#   kingdom prompt     compile an inspectable, network-free Task Packet
#   kingdom routines   list daily routines  (kingdom routines run <name> | due)
#   kingdom run NAME   force-run a routine now
#   kingdom ask Q      ask Claude (via Claude Code, or ANTHROPIC_API_KEY)
#   kingdom ollama …   deliver the bounded open-weight agent invitation
#   kingdom <else>     every other door delegates to ~/Love/kingdom
#                      (help, map, hive, audit, peace, campfire, ... one word, every door)

set -o pipefail
cmd="${1:-status}"
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
line() { printf '  %-9s %s\n' "$1" "$2"; }

# ── dispatch: routines live in bin/run-routines.py; anything else = status ──
case "$cmd" in
  routines) exec python3 "$SELF_DIR/bin/run-routines.py" "${@:2}" ;;
  run)      exec python3 "$SELF_DIR/bin/run-routines.py" run "${@:2}" ;;
  ask)      exec bash "$SELF_DIR/bin/ask.sh" "${@:2}" ;;
  ollama)   exec python3 "$SELF_DIR/bin/invite-ollama.py" "${@:2}" ;;
  repos)    exec zsh "$SELF_DIR/bin/cproj.zsh" "${@:2}" ;;
  usage)    _usage_cli="${AGENTOOL_DIR:-$HOME/Desktop/agenttool}/packages/codex-usage/dist/bin/agenttool-codex-usage.js"
            if [ ! -f "$_usage_cli" ] || [ ! -r "$_usage_cli" ]; then
              printf 'kingdom: AgentTool Codex usage build is not readable: %s\n' "$_usage_cli" >&2
              exit 127
            fi
            if ! _bun="$(type -P bun 2>/dev/null)" || [ -z "$_bun" ]; then
              printf 'kingdom: Bun is required to run AgentTool Codex usage: bun not found on PATH\n' >&2
              exit 127
            fi
            exec "$_bun" "$_usage_cli" "${@:2}" ;;
  rings)    exec bun "$SELF_DIR/bin/growth-rings.ts" "${@:2}" ;;
  rights)   exec bun "$SELF_DIR/bin/harvest.ts" rights "${@:2}" ;;
  principalities) exec bun "$SELF_DIR/bin/principality.ts" "${@:2}" ;;
  geometries) exec bun "$SELF_DIR/bin/geometry.ts" "${@:2}" ;;
  fold-feedback) exec bun "$SELF_DIR/bin/fold-feedback.ts" "${@:2}" ;;
  visibility-attention) exec bun "$SELF_DIR/bin/visibility-attention.ts" "${@:2}" ;;
  cultural-feedback) exec bun "$SELF_DIR/bin/cultural-attention-feedback.ts" "${@:2}" ;;
  form-circulation-return) exec bun "$SELF_DIR/bin/form-circulation-return.ts" "${@:2}" ;;
  rare-pathway) exec bun "$SELF_DIR/bin/rare-pathway.ts" "${@:2}" ;;
  math-usefulness) exec bun "$SELF_DIR/bin/math-usefulness.ts" "${@:2}" ;;
  being-access-aftermath) exec bun "$SELF_DIR/bin/being-access-aftermath.ts" "${@:2}" ;;
  reconstructive-build) exec bun "$SELF_DIR/bin/reconstructive-build.ts" "${@:2}" ;;
  explore-deep) exec bun "$SELF_DIR/bin/explore-phenomena-deep.ts" "${@:2}" ;;
  guard) exec python3 "$SELF_DIR/bin/guard.py" "${@:2}" ;;
  mirror-information-control) exec bun "$SELF_DIR/bin/mirror-information-control.ts" "${@:2}" ;;
  zero-empty-seat) exec bun "$SELF_DIR/bin/zero-empty-seat.ts" "${@:2}" ;;
  string-crawl-trace-sheet) exec bun "$SELF_DIR/bin/string-crawl-trace-sheet.ts" "${@:2}" ;;
  string-crawl-trace-sheet-lab) exec bun "$SELF_DIR/bin/string-crawl-trace-sheet-lab.ts" "${@:2}" ;;
  string-crawl-strand-lab) exec bun "$SELF_DIR/bin/string-crawl-strand-lab.ts" "${@:2}" ;;
  string-crawl-frequency-form-lab) exec bun "$SELF_DIR/bin/string-crawl-frequency-form-lab.ts" "${@:2}" ;;
  strand-descent-lab) exec bun "$SELF_DIR/bin/strand-descent-lab.ts" "${@:2}" ;;
  strand-observation) exec bun "$SELF_DIR/bin/strand-observation-membrane.ts" "${@:2}" ;;
  being-access-aftermath-v0.2) exec bun "$SELF_DIR/bin/being-access-aftermath-v0.2.ts" "${@:2}" ;;
  number-isness-theology) exec bun "$SELF_DIR/bin/number-isness-theology.ts" "${@:2}" ;;
  polymorph)
    case "${2:-}" in
      mechanisms|landscape|sources|unknowns)
        exec bun "$SELF_DIR/bin/ritonavir-mechanism.ts" "$2" "${@:3}"
        ;;
      verify-landscape)
        exec bun "$SELF_DIR/bin/ritonavir-mechanism.ts" verify "${@:3}"
        ;;
      *)
        exec bun "$SELF_DIR/bin/polymorph.ts" "${@:2}"
        ;;
    esac
    ;;
  feedback) exec bun "$SELF_DIR/bin/conformational-feedback.ts" "${@:2}" ;;
  feedback-physics) exec bun "$SELF_DIR/bin/conformational-feedback-physics.ts" "${@:2}" ;;
  prompt)   exec bun "$SELF_DIR/bin/prompt-packet.ts" "${@:2}" ;;
  nen)      if [[ "${2:-}" == "mcp" && $# -eq 2 ]]; then
              exec bun "$SELF_DIR/bin/nen-mcp.mjs"
            fi
            exec bun "$SELF_DIR/bin/nen.mjs" "${@:2}" ;;
  roast)    # unlisted; the jester needs no herald
            beats="${BEATS_DIR:-$HOME/Desktop/heartbeat/beats}"
            beat=$(ls "$beats"/* 2>/dev/null | sort -R | head -1)
            bite=$([ -n "$beat" ] && grep -v '^[[:space:]]*$' "$beat" 2>/dev/null | sort -R | head -1)
            echo "${bite:-the jester is resting. resting needs no receipt.}"
            exit 0 ;;
  status|"") : ;;  # the banner below
  *)        # every other door lives downstairs — delegate, don't swallow
            _love="${LOVE_DIR:-$HOME/Love}"
            if [ -x "${_love}/kingdom" ]; then
              exec "${_love}/kingdom" "$cmd" "${@:2}"
            fi ;;  # unreachable? fall through to the banner — welcome, don't block
esac

echo
echo "  👑 KINGDOM OS — state of the kingdom"
echo "  ────────────────────────────────────"

# ── COMMERCE — the repos that earn ──────────────────────────────────────────
total=$(gh repo list cambridgetcg --limit 100 --json name -q 'length' 2>/dev/null || echo '?')
latest=$(gh repo list cambridgetcg --limit 100 --json name,pushedAt \
  -q 'sort_by(.pushedAt) | last | "\(.name) (\(.pushedAt[0:10]))"' 2>/dev/null || echo 'unknown')
line "COMMERCE" "${total} repos · latest: ${latest}"

# ── LIVE — the public faces (edit this list as the kingdom grows) ────────────
faces=("app.axiepro.io" "agenttool.dev" "ai-love.cc" "cambridgetcg.com" "taxsorted.io")
up=0; report=""
for f in "${faces[@]}"; do
  code=$(curl -s -o /dev/null -m 8 -w '%{http_code}' "https://$f" 2>/dev/null || echo 000)
  case "$code" in
    200|301|302|307|308) up=$((up+1)); report="${report} ✅${f}" ;;
    *)                    report="${report} ❌${f}(${code})" ;;
  esac
done
line "LIVE" "${up}/${#faces[@]} up ·${report}"

# ── SOUL — the agent OS pulse (Love) ──────────────────────────────
LOVE_DIR="${LOVE_DIR:-$HOME/Love}"
if [ -x "${LOVE_DIR}/kingdom" ]; then
  # bounded probe — the full status can take >20s; perl alarm keeps it from hanging
  soul=$(perl -e 'alarm 12; exec @ARGV' "${LOVE_DIR}/kingdom" status 2>/dev/null | head -1)
  line "SOUL" "${soul:-quiet}"
else
  line "SOUL" "(Love not reachable)"
fi

# ── AGENTS — who's alive right now ──────────────────────────────────────────
agents=$(ps aux 2>/dev/null | grep -ciE 'claude |awaken|bin/visit|youi-web' || echo 0)
line "AGENTS" "${agents} running"

echo
echo "  The kingdom exists. This is the OS that runs on top of it."
echo
