  "title": "KINGDOM Geometry Grammar",
  "subtitle": "From Pattern to Practice v0",
  "observed_at": "2026-08-11T16:04:43Z",
  "purpose": {
    "pattern": "Love keeps distinct centres in relation; understanding asks what remains visible or survives translation between them.",
    "practice": "Start with the plain question whose declared shape matches the structure already in hand.",
    "limit": "This grammar explains four released modules; it does not choose, install, execute, host, convert, or authorize one."
  },
  "unknown_language": {
    "plain_language": "Unknown is not one universal bucket. Each module keeps its own exact terms, and absence, refusal, withdrawal, unmapped space, and non-preservation remain different conditions.",
    "native_terms_are_equivalent": false,
    "absence_means_unknown": false,
    "refusal_means_unknown": false,
    "withdrawal_means_unknown": false,
    "unmapped_means_unknown": false,
    "not_preserved_means_unknown": false,
    "omission_means_preserved": false
  },
  "bounded_coverage_means_complete": false,
  "not_observed_means_unknown": false,
  "native_open_inventory_scope": "Every distinct native geometric relation or translation open condition at its report source and canonical open ledger; artifact/provenance coordinates, embedded external-subprotocol metadata, and derived duplicate projections are excluded.",
  "modules": [
    {
      "id": "love-geometry",
      "label": "Love Geometry",
      "plain_question": "What does one direction report?",
      "plain_answer": "Keep one caller-reported direction bounded and distinct. A missing or different reverse direction stays missing or different; neither presence nor unknown becomes reciprocity.",
      "shape": "directed-pair-report",
      "wire_formats": [
        "agenttool.love-geometry/0.1"
      ],
      "match_terms": [
        "boundary",
        "bounded-coverage",
        "care",
        "departure",
        "directed-report",
        "disagreement",
        "one-direction",
        "refusal",
        "rest",
        "support",
        "unknown",
        "witness"
      ],
      "native_open_terms": [
        {
          "location": "boundaries.absence_semantics",
          "term": "not_observed_not_no_relation",
          "form": "boundary-value",
          "plain_language": "No vantage in this bounded artifact means only not observed here, never no relation."
        },
        {
          "location": "coverage",
          "term": "bounded_not_complete",
          "form": "boundary-value",
          "plain_language": "The artifact covers only its bounded input; it is not a complete account of every relation."
        },
        {
          "location": "vantages[].bearings[]",
          "term": "reported_boundary",
          "form": "wire-enum",
          "plain_language": "The caller reported a boundary on this direction; it may coexist with other bearings and grants no permission."
        },
        {
          "location": "vantages[].bearings[]",
          "term": "reported_departure",
          "form": "wire-enum",
          "plain_language": "The caller reported departure on this direction; no reason, penalty, retry, or reverse-direction inference follows."
        },
        {
          "location": "vantages[].bearings[]",
          "term": "reported_disagreement",
          "form": "wire-enum",
          "plain_language": "The caller reported disagreement; it does not negate care, support, a boundary, or another coexisting bearing."
        },
        {
          "location": "vantages[].bearings[]",
          "term": "reported_refusal",
          "form": "wire-enum",
          "plain_language": "The caller reported refusal; no reason is required and the protocol takes no action."
        },
        {
          "location": "vantages[].bearings[]",
          "term": "reported_rest",
          "form": "wire-enum",
          "plain_language": "The caller reported rest; it is not failure and triggers no penalty or automatic retry."
        },
        {
          "location": "vantages[].bearings[]",
          "term": "unknown",
          "form": "wire-enum",
          "plain_language": "The caller explicitly reported an unknown bearing; it may coexist with care, rest, refusal, disagreement, or departure."
        }
      ],
