          "form": "wire-enum",
          "plain_language": "A caller can report the subject absent from this perspective; that is not global absence, not-observed, or unknown."
        },
        {
          "location": "charts[].claims[].posture",
          "term": "contested",
          "form": "wire-enum",
          "plain_language": "A caller can mark a claim contested; disagreement remains visible and the package resolves no winner or latest truth."
        },
        {
          "location": "charts[].claims[].posture",
          "term": "withdrawn",
          "form": "wire-enum",
          "plain_language": "A withdrawn claim remains in the chart; withdrawal does not erase it or select a canonical replacement."
        },
        {
          "location": "charts[].claims[].posture",
          "term": "not_observed",
          "form": "wire-enum",
          "plain_language": "Not observed is an explicit claim posture and is not the same as unknown."
        },
        {
          "location": "charts[].claims[].posture",
          "term": "unknown",
          "form": "wire-enum",
          "plain_language": "Unknown is a separate explicit claim posture; it does not erase a conflicting or earlier claim."
        },
        {
          "location": "bridges[].correspondences[].posture",
          "term": "incompatibility_reported",
          "form": "wire-enum",
          "plain_language": "The caller reported incompatibility for this directed correspondence; it is not equality, absence, or verified semantic conflict."
        },
        {
          "location": "bridges[].correspondences[].posture",
          "term": "unknown",
          "form": "wire-enum",
          "plain_language": "A correspondence can explicitly remain unknown without becoming equality, incompatibility, or absence."
        },
        {
          "location": "bridges[].unmapped_from_refs",
          "term": "unmapped",
          "form": "wire-array",
          "plain_language": "Cells on the source side can remain explicitly outside the partial bridge."
        },
        {
          "location": "bridges[].unmapped_to_refs",
          "term": "unmapped",
          "form": "wire-array",
          "plain_language": "Cells on the destination side can remain explicitly outside the partial bridge."
        },
        {
          "location": "bridges[].coverage",
          "term": "partial_not_complete",
          "form": "boundary-value",
          "plain_language": "Each directed bridge is explicitly partial; its correspondences do not claim a total map between charts."
        },
        {
          "location": "coverage",
          "term": "bounded_not_complete",
          "form": "boundary-value",
          "plain_language": "The atlas covers only its bounded charts and bridges; it is not a complete global account."
        }
      ],
