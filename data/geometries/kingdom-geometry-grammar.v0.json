    {
      "id": "principality-atlas",
      "label": "Principality Atlas",
      "plain_question": "How can several partial maps coexist without pretending there is one total map?",
      "plain_answer": "Keep chart-local cells, n-ary relations, contradictory claims, and lossy directed correspondences plural. Unmapped space remains visible, and correspondence never silently becomes equality or gluing.",
      "shape": "plural-partial-incidence-atlas",
      "wire_formats": [
        "agenttool.principality-incidence-atlas/0.1"
      ],
      "match_terms": [
        "bounded-coverage",
        "chart",
        "contested",
        "contradiction",
        "hypergraph",
        "incompatibility",
        "n-ary-relation",
        "not-observed",
        "partial-map",
        "perspective",
        "reported-absence",
        "translation",
        "unknown",
        "unmapped",
        "withdrawal"
      ],
      "native_open_terms": [
        {
          "location": "charts[].claims[].posture",
